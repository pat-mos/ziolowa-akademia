---
import { Image } from 'astro:assets';
import portret from '../assets/img/o-mnie.jpeg';

// Dłuższy opis pokazywany w oknie (modalu) po kliknięciu „Więcej o mnie".
// To tekst przykładowy — Monika może go swobodnie rozbudować.
const bio = [
  'Nazywam się Monika i jestem twórczynią Ziołowej Akademii. Ukończyłam biologię (magister) oraz pedagogikę, a od lat łączę te dwie pasje, prowadząc zajęcia edukacyjne oparte na bezpośrednim kontakcie z naturą.',
  'Wierzę, że najlepiej uczymy się przez doświadczenie — dotyk, zapach i samodzielne działanie. Dlatego moje warsztaty to nie wykłady, ale wspólne odkrywanie świata roślin: rozcieranie ziół, tworzenie zielników i mieszanek, obserwacja przyrody wszystkimi zmysłami.',
  'Pracuję z dziećmi z przedszkoli i szkół, a także prowadzę spokojne, regenerujące spotkania dla dorosłych. Każde zajęcia dopasowuję do wieku i potrzeb grupy, dbając o ciepłą, bezpieczną atmosferę.',
];
---
<section class="section o-mnie" id="o-mnie">
  <div class="container o-grid">
    <div class="o-photo">
      <Image src={portret} alt="Monika — twórczyni Ziołowej Akademii" widths={[400, 700]} sizes="(max-width: 800px) 90vw, 500px" />
    </div>

    <div class="o-text">
      <span class="eyebrow">O Ziołowej Akademii</span>
      <h2 class="section-title">Nazywam się Monika</h2>
      <p>
        Jestem twórczynią Ziołowej Akademii, magistrem biologii i pedagogiem.
        Moją specjalizacją są zajęcia edukacyjne dla dzieci oparte na
        bezpośrednim kontakcie z naturą i doświadczeniu.
      </p>
      <p>
        Prowadzę warsztaty, które łączą naukę, zabawę i uważność — tak, by
        każdy uczestnik mógł poznawać rośliny wszystkimi zmysłami.
      </p>
      <button class="btn btn-lime" id="o-mnie-btn">Więcej o mnie</button>
    </div>
  </div>
</section>

<!-- Okno (modal) z rozwiniętym opisem Moniki -->
<div class="modal" id="omnie-modal" aria-hidden="true">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="omnie-modal-title">
    <button class="modal-close" data-close aria-label="Zamknij">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <div class="modal-scroll">
      <div class="modal-content">
        <h3 id="omnie-modal-title">Więcej o mnie</h3>
        <div class="modal-body">
          {bio.map((par) => <p>{par}</p>)}
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <a href="#kontakt" class="btn btn-lime" data-close>Napisz do mnie</a>
    </div>
  </div>
</div>

<script>
  import Lenis from 'lenis';

  const modal = document.getElementById('omnie-modal');

  // Smooth scroll (bezwładność jak na stronie) wewnątrz popovera.
  let modalLenis = null;
  let modalRaf = null;
  function startModalScroll() {
    const wrapper = modal.querySelector('.modal-scroll');
    const content = modal.querySelector('.modal-content');
    if (!wrapper || !content || modalLenis) return;
    modalLenis = new Lenis({ wrapper, content, duration: 1.1 });
    const loop = (time) => {
      modalLenis?.raf(time);
      modalRaf = requestAnimationFrame(loop);
    };
    modalRaf = requestAnimationFrame(loop);
  }
  function stopModalScroll() {
    if (modalRaf) cancelAnimationFrame(modalRaf);
    modalRaf = null;
    modalLenis?.destroy();
    modalLenis = null;
  }

  const open = () => {
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    window.lenis?.stop();
    startModalScroll();
  };
  const close = () => {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    window.lenis?.start();
    stopModalScroll();
  };
  document.getElementById('o-mnie-btn')?.addEventListener('click', open);
  modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  .o-mnie { background: var(--cream); }
  /* w układzie obok zdjęcia nagłówek zostaje do lewej */
  .o-text .eyebrow { text-align: left; }
  .o-text .section-title { text-align: left; margin-inline: 0; }
  .o-grid {
    display: grid;
    grid-template-columns: 574px 1fr;   /* zdjęcie 574px, tekst wypełnia resztę */
    gap: 56px;
    align-items: center;
  }
  .o-photo img {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    object-fit: cover;
    aspect-ratio: 574 / 559;  /* wymiary jak w oryginale */
    outline: 1px solid oklch(0 0 0 / 0.1);   /* subtelny obrys — głębia */
    outline-offset: -1px;
  }
  .o-text p { color: var(--muted); margin-top: 18px; max-width: 52ch; }
  .o-text .btn { margin-top: 28px; }

  @media (max-width: 800px) {
    .o-grid { grid-template-columns: 1fr; gap: 32px; }
  }

  /* --- Modal (te same style co w ofercie) --- */
  .modal {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center; padding: 24px;
    opacity: 0; pointer-events: none;
    transition: opacity .18s ease;   /* zamknięcie: szybciej */
    will-change: opacity;
  }
  .modal.open { opacity: 1; pointer-events: auto; transition: opacity .28s ease; }
  .modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(20,30,18,.55); backdrop-filter: blur(3px);
  }
  .modal-dialog {
    position: relative; z-index: 1;
    background: var(--white); border-radius: var(--radius);
    max-width: 560px; width: 100%; max-height: 85vh;
    display: flex; flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,.3);
    transform: translateY(18px) scale(.96);
    transition: transform .18s cubic-bezier(.2, .8, .2, 1);   /* zamknięcie: szybciej */
  }
  .modal.open .modal-dialog { transform: none; transition: transform .3s cubic-bezier(.2, .8, .2, 1); }
  @media (prefers-reduced-motion: reduce) {
    .modal, .modal-dialog { transition: none; }
    .modal-dialog { transform: none; }
  }
  .modal-scroll {
    overflow-y: auto;
    padding: 40px 40px 24px;
    -webkit-overflow-scrolling: touch;
  }
  .modal-foot {
    flex-shrink: 0;
    padding: 20px 40px;
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  /* padding-right: 48px = X (40px szer. przy right:24) + 24px odstępu od tytułu */
  .modal-dialog h3 { font-size: 1.6rem; margin-bottom: 16px; padding-right: 48px; }
  .modal-body p { color: var(--muted); margin-bottom: 14px; }
  .modal-foot .btn { margin: 0; width: auto; }
  .modal-close {
    position: absolute; top: 24px; right: 24px;   /* min. 24px od krawędzi */
    z-index: 2;
    width: 40px; height: 40px; border-radius: 50%; border: none;
    background: var(--cream); cursor: pointer;
    color: var(--ink);
    display: grid; place-items: center;
    transition: background .15s ease, transform .1s ease;
  }
  .modal-close:active { transform: scale(.96); }
  .modal-close:hover { background: var(--line); }
</style>
