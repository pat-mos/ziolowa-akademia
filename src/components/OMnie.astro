---
import { Image } from 'astro:assets';
import portret from '../assets/img/o-mnie.jpeg';

// Dłuższy opis pokazywany w oknie (modalu) po kliknięciu „Więcej o mnie".
// To tekst przykładowy — Monika może go swobodnie rozbudować.
const bio = [
  'Nazywam się Monika i jestem twórczynią Ziołowej Akademii. Ukończyłam biologię (magister) oraz pedagogikę, a od lat łączę te dwie pasje, prowadząc zajęcia edukacyjne oparte na bezpośrednim kontakcie z naturą.',
  'Wierzę, że najlepiej uczymy się przez doświadczenie — dotyk, zapach i samodzielne działanie. Dlatego moje warsztaty to nie wykłady, ale wspólne odkrywanie świata roślin: rozcieranie ziół, tworzenie zielników i mieszanek, obserwacja przyrody wszystkimi zmysłami.',
  'Pracuję z dziećmi z przedszkoli i szkół, a także prowadzę spokojne, regenerujące spotkania dla dorosłych. Każde zajęcia dopasowuję do wieku i potrzeb grupy, dbając o ciepłą, bezpieczną atmosferę.',
];
---
<section class="section o-mnie falbanka-gora falbanka-dol" id="o-mnie">
  <div class="container o-grid">
    <div class="o-photo">
      <Image src={portret} alt="Monika — twórczyni Ziołowej Akademii" widths={[400, 700]} sizes="(max-width: 800px) 90vw, 500px" />
      {/* Iskierki na wierzchu zdjęcia — czysta dekoracja, stąd aria-hidden */}
      <span class="o-iskra o-iskra--1" aria-hidden="true"></span>
      <span class="o-iskra o-iskra--2" aria-hidden="true"></span>
      <span class="o-iskra o-iskra--3" aria-hidden="true"></span>
    </div>

    <div class="o-text">
      <span class="eyebrow">O Ziołowej Akademii</span>
      <h2 class="section-title">Nazywam się Monika</h2>
      <p>
        Jestem twórczynią Ziołowej Akademii, magistrem biologii i pedagogiem.
        Moją specjalizacją są zajęcia edukacyjne dla dzieci oparte na
        bezpośrednim kontakcie z naturą i doświadczeniu.
      </p>
      <p>
        Prowadzę warsztaty, które łączą naukę, zabawę i uważność — tak, by
        każdy uczestnik mógł poznawać rośliny wszystkimi zmysłami.
      </p>
      <button class="btn btn-lime" id="o-mnie-btn">Więcej o mnie</button>
    </div>
  </div>
</section>

<!-- Okno (modal) z rozwiniętym opisem Moniki -->
<div class="modal" id="omnie-modal" aria-hidden="true">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="omnie-modal-title">
    <button class="modal-close" data-close aria-label="Zamknij">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <div class="modal-scroll">
      <div class="modal-content">
        <h3 id="omnie-modal-title">Więcej o mnie</h3>
        <div class="modal-body">
          {bio.map((par) => <p>{par}</p>)}
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <a href="#kontakt" class="btn btn-lime" data-close>Napisz do mnie</a>
    </div>
  </div>
</div>

<script>
  import Lenis from 'lenis';

  const modal = document.getElementById('omnie-modal');

  // Smooth scroll (bezwładność jak na stronie) wewnątrz popovera.
  let modalLenis = null;
  let modalRaf = null;
  function startModalScroll() {
    const wrapper = modal.querySelector('.modal-scroll');
    const content = modal.querySelector('.modal-content');
    if (!wrapper || !content || modalLenis) return;
    modalLenis = new Lenis({ wrapper, content, duration: 1.1 });
    const loop = (time) => {
      modalLenis?.raf(time);
      modalRaf = requestAnimationFrame(loop);
    };
    modalRaf = requestAnimationFrame(loop);
  }
  function stopModalScroll() {
    if (modalRaf) cancelAnimationFrame(modalRaf);
    modalRaf = null;
    modalLenis?.destroy();
    modalLenis = null;
  }

  // Element do przywrócenia fokusu po zamknięciu (przycisk „Więcej o mnie").
  const triggerBtn = document.getElementById('o-mnie-btn');

  // Uwięzienie Tab w oknie — aria-modal nie blokuje fokusu.
  function trapTab(e) {
    if (e.key !== 'Tab') return;
    const lista = [...modal.querySelectorAll(
      'a[href], button, textarea, input, [tabindex]:not([tabindex="-1"])'
    )].filter((el) => el.offsetParent !== null);
    if (!lista.length) return;
    const pierwszy = lista[0];
    const ostatni = lista[lista.length - 1];
    if (e.shiftKey && document.activeElement === pierwszy) {
      e.preventDefault(); ostatni.focus();
    } else if (!e.shiftKey && document.activeElement === ostatni) {
      e.preventDefault(); pierwszy.focus();
    }
  }

  const open = () => {
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    window.lenis?.stop();
    startModalScroll();
    modal.addEventListener('keydown', trapTab);
    modal.querySelector('.modal-close')?.focus();
  };
  const close = () => {
    if (!modal.classList.contains('open')) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    window.lenis?.start();
    stopModalScroll();
    modal.removeEventListener('keydown', trapTab);
    triggerBtn?.focus();
  };
  triggerBtn?.addEventListener('click', open);
  modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  /* tło sekcji (ciepłe + rozbłysk) jest w global.css — patrz `.o-mnie, .galeria` */
  /* w układzie obok zdjęcia nagłówek zostaje do lewej */
  .o-text .eyebrow { text-align: left; }
  .o-text .section-title { text-align: left; margin-inline: 0; }
  .o-grid {
    display: grid;
    /* Kolumny w proporcjach, NIE sztywne 574px — przy sztywnej kolumnie zdjęcia
       tekst ściskał się na tablecie do ~145px. minmax(0,…) pozwala kolumnom
       zejść poniżej rozmiaru zawartości, bez tego siatka i tak by się rozpychała. */
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    /* 96px, a nie 56: plama za zdjęciem wystaje spod niego o ~36px w prawo
       (inset -6%), więc przy 56px tekst miał od niej realnie tylko 20px
       i wyglądał na przyklejony. Liczy się odstęp od plamy, nie od zdjęcia. */
    column-gap: 96px;
    row-gap: 32px;
    align-items: center;
  }
  /* --- Zdjęcie w organicznym kształcie + plama i iskierki wokół ---
     Kształt robi asymetryczny border-radius (osobne promienie poziome i
     pionowe po ukośniku) — jedna „kropla", bez pliku graficznego.
     `--blob` trzyma go w jednym miejscu, żeby plama pod spodem miała
     dokładnie ten sam obrys co zdjęcie. */
  .o-photo {
    --blob: 58% 42% 47% 53% / 48% 45% 55% 52%;
    position: relative;
  }

  /* Plama za zdjęciem: ten sam kształt, lekko obrócony i przesunięty,
     żeby wystawał zza krawędzi. Odpowiednik ich obrazka „image-two”. */
  .o-photo::before {
    content: '';
    position: absolute;
    inset: 5% -6% -7% 4%;
    background: var(--pastel-limonka);
    border-radius: var(--blob);
    transform: rotate(-5deg);
    z-index: 0;
    pointer-events: none;
  }

  .o-photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: var(--blob);
    box-shadow: var(--shadow);
    object-fit: cover;
    aspect-ratio: 574 / 559;  /* wymiary jak w oryginale */
    /* Obrys musi być CZYSTĄ czernią z niskim kryciem, nie przygaszoną zielenią —
       barwiony obrys łapie kolor tła pod spodem i czyta się jak brud na
       krawędzi zdjęcia. Podąża za border-radius, więc działa i na kropli. */
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }

  /* Iskierki — czterokątne gwiazdki wycięte z kwadratu clip-path. */
  .o-iskra {
    position: absolute;
    z-index: 2;
    aspect-ratio: 1;
    background: currentColor;
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
    pointer-events: none;
  }
  .o-iskra--1 { width: 34px; top: 6%;  left: -3%;  color: var(--lime); }
  .o-iskra--2 { width: 20px; top: 20%; left: 4%;   color: var(--herb); }
  .o-iskra--3 { width: 26px; bottom: 8%; right: -2%; color: var(--pastel-piasek); }
  .o-text p { color: var(--muted); margin-top: 18px; max-width: 52ch; }
  .o-text .btn { margin-top: 28px; }

  /* Próg 900px, nie 800: przy 820px dwie kolumny już się nie mieszczą. */
  @media (max-width: 900px) {
    .o-grid { grid-template-columns: 1fr; gap: 32px; }
    /* zdjęcie nad tekstem nie powinno zjadać całego pierwszego ekranu */
    .o-photo { max-width: 460px; margin-inline: auto; width: 100%; }
    /* Wyrównanie do lewej ma sens TYLKO obok zdjęcia. Gdy kolumny się składają,
       tekst musi wrócić na środek — inaczej ta jedna sekcja wisi przy lewej
       krawędzi, podczas gdy Wartości, Oferta i FAQ są wyśrodkowane. */
    .o-text { text-align: center; }
    .o-text .eyebrow { text-align: center; }
    .o-text .section-title { text-align: center; margin-inline: auto; }
    .o-text p { margin-inline: auto; }
  }

  /* --- Modal (te same style co w ofercie) --- */
  .modal {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center; padding: 24px;
    opacity: 0; pointer-events: none;
    transition: opacity var(--duration-quick) var(--ease-smooth-out);   /* zamknięcie: szybciej */
    will-change: opacity;
  }
  .modal.open { opacity: 1; pointer-events: auto; transition: opacity var(--duration-fast) var(--ease-smooth-out); }
  .modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(20,30,18,.55); backdrop-filter: blur(3px);
  }
  .modal-dialog {
    position: relative; z-index: 1;
    background: var(--white); border-radius: var(--radius);
    max-width: 560px; width: 100%; max-height: 85vh;
    display: flex; flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,.3);
    transform: translateY(18px) scale(.96);
    transition: transform var(--duration-quick) var(--ease-smooth-out);   /* zamknięcie: szybciej */
  }
  .modal.open .modal-dialog { transform: none; transition: transform var(--duration-fast) var(--ease-smooth-out); }
  @media (prefers-reduced-motion: reduce) {
    .modal, .modal-dialog { transition: none; }
    .modal-dialog { transform: none; }
  }
  .modal-scroll {
    overflow-y: auto;
    padding: 40px 40px 24px;
    -webkit-overflow-scrolling: touch;
  }
  .modal-foot {
    flex-shrink: 0;
    padding: 20px 40px;
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  /* padding-right: 48px = X (40px szer. przy right:24) + 24px odstępu od tytułu */
  .modal-dialog h3 { font-size: 1.6rem; margin-bottom: 16px; padding-right: 48px; }
  .modal-body p { color: var(--muted); margin-bottom: 14px; }
  .modal-foot .btn { margin: 0; width: auto; }
  .modal-close {
    position: absolute; top: 24px; right: 24px;   /* min. 24px od krawędzi */
    z-index: 2;
    width: 44px; height: 44px; border-radius: 50%; border: none;
    background: var(--cream); cursor: pointer;
    color: var(--ink);
    display: grid; place-items: center;
    transition: background .15s ease, transform .1s ease;
  }
  .modal-close:active { transform: scale(.96); }
  .modal-close:hover { background: var(--line); }
</style>
