---
import { Image } from 'astro:assets';
import heroImg from '../assets/img/hero.jpeg';
---
<section class="hero" id="top">
  <Image
    class="hero-bg"
    src={heroImg}
    alt="Grupa dzieci na spacerze leśną ścieżką wśród sosen"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>

  <div class="hero-content container">
    {/* &nbsp; po jednoliterowych spójnikach — polska zasada: „i", „o", „z"
        nie mogą zostać sierotą na końcu linii */}
    <h1>Edukacja i&nbsp;doświadczenie natury dla dzieci i&nbsp;dorosłych</h1>
    <p>
      Ziołowa Akademia to warsztaty, spacery botaniczne i&nbsp;kąpiele leśne
      dla przedszkoli, szkół oraz dorosłych.
    </p>
    <a href="#kontakt" class="btn btn-lime">Zapytaj o dostępne terminy</a>
  </div>
</section>

<style>
  .hero {
    position: fixed;           /* przyklejone w tle — treść przewija się nad nim */
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    /* Dodatkowy odstęp u góry, by nagłówek nie chował się za nawigacją */
    padding-top: 120px;
    padding-bottom: 60px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* Przyciemnienie, żeby biały tekst był czytelny na zdjęciu */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,30,18,.35), rgba(20,30,18,.45));
    z-index: -1;
  }
  .hero-content { color: var(--white); }
  .hero-content h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    line-height: 1.05;         /* ciaśniejsza interlinia dla dużego display */
    max-width: 24ch;           /* mieści „Edukacja i doświadczenie" w jednej linii */
    margin-inline: auto;
    letter-spacing: -0.01em;   /* delikatniejszy tracking */
    text-shadow: 0 2px 24px rgba(0,0,0,.25);
  }
  .hero-content p {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    max-width: 46ch;
    margin: 24px auto 32px;
    opacity: .95;
  }
</style>
