---
import { Image } from 'astro:assets';
import heroImg from '../assets/img/hero.jpeg';
---
<section class="hero" id="top">
  <Image
    class="hero-bg"
    src={heroImg}
    alt="Grupa dzieci na spacerze leśną ścieżką wśród sosen"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>

  <div class="hero-content container">
    {/* &nbsp; po jednoliterowych spójnikach — polska zasada: „i", „o", „z"
        nie mogą zostać sierotą na końcu linii */}
    <h1>Edukacja i&nbsp;doświadczenie natury dla dzieci i&nbsp;dorosłych</h1>
    <p>
      Ziołowa Akademia to warsztaty, spacery botaniczne i&nbsp;kąpiele leśne
      dla przedszkoli, szkół oraz dorosłych.
    </p>
    <a href="#kontakt" class="btn btn-lime">Zapytaj o dostępne terminy</a>
  </div>
</section>

<style>
  .hero {
    position: fixed;           /* przyklejone w tle — treść przewija się nad nim */
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    /* Dodatkowy odstęp u góry, by nagłówek nie chował się za nawigacją */
    padding-top: 120px;
    padding-bottom: 60px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* Przyciemnienie, żeby biały tekst był czytelny na zdjęciu */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,30,18,.35), rgba(20,30,18,.45));
    z-index: -1;
  }
  .hero-content { color: var(--white); }

  /* --- Wejście hero: rozmycie + delikatne uniesienie, raz przy wczytaniu ---
     Animujemy trzy osobne kawałki z kaskadą 100ms, a nie cały kontener naraz —
     dzięki temu czyta się jak sekwencja, nie jak jeden skok.
     `both` trzyma stan początkowy przed startem, więc nic nie mignie.
     Rozmycie jest TYLKO tutaj: to jedyny moment na stronie, gdzie blur jest
     tani — trzy elementy, jeden raz, przy wczytaniu. Przy przewijaniu sekcji
     używamy samego opacity (patrz global.css), bo blur na każdej sekcji
     kosztowałby GPU przez cały czas scrollowania. */
  .hero-content h1,
  .hero-content p,
  .hero-content .btn {
    animation: heroWejscie .75s cubic-bezier(.2, .8, .2, 1) both;
  }
  .hero-content h1 { animation-delay: .15s; }
  .hero-content p { animation-delay: .25s; }
  .hero-content .btn { animation-delay: .35s; }

  @keyframes heroWejscie {
    from { opacity: 0; filter: blur(8px); translate: 0 14px; }
    to   { opacity: 1; filter: blur(0);   translate: 0 0; }
  }
  /* akapit ma docelowo .95 krycia — bez tego animacja podbiłaby go do 1 */
  .hero-content p { animation-name: heroWejscieAkapit; }
  @keyframes heroWejscieAkapit {
    from { opacity: 0; filter: blur(8px); translate: 0 14px; }
    to   { opacity: .95; filter: blur(0); translate: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content h1,
    .hero-content p,
    .hero-content .btn { animation: none; }
  }
  .hero-content h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    line-height: 1.05;         /* ciaśniejsza interlinia dla dużego display */
    max-width: 24ch;           /* mieści „Edukacja i doświadczenie" w jednej linii */
    margin-inline: auto;
    letter-spacing: -0.01em;   /* delikatniejszy tracking */
    text-shadow: 0 2px 24px rgba(0,0,0,.25);
  }
  .hero-content p {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    max-width: 46ch;
    margin: 24px auto 32px;
    opacity: .95;
  }
</style>
