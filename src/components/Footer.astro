---
const rok = new Date().getFullYear();
const email = 'ziolowaakademia@wp.pl';
const telefon = '781 864 944';
const telefonHref = '+48781864944';
const social = {
  facebook: 'https://www.facebook.com/ziolowaakademia25',
  instagram: 'https://www.instagram.com/ziolowa.akademia/',
};
---
<footer class="footer falbanka-gora">
  <div class="container">
    {/* Desktop: logo | nawigacja | kontakt — kolumny na środku wysokości logo */}
    <div class="footer-top">
      <a href="#top" class="footer-logo">
        <img
          src="/img/logo-wordmark.png"
          alt="Ziołowa Akademia"
          width="240"
          height="194"
        />
      </a>

      <nav class="footer-col footer-col--nav">
        <h3>Nawigacja</h3>
        <a href="#o-mnie">O Ziołowej Akademii</a>
        <a href="#oferta">Zajęcia</a>
        <a href="#kontakt">Kontakt</a>
      </nav>

      <div class="footer-col footer-col--kontakt">
        <h3>Kontakt</h3>
        <a href={`mailto:${email}`} class="footer-contact-link">
          {/* Material Icons — mail */}
          <svg class="footer-contact-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
          </svg>
          <span>{email}</span>
        </a>
        <a href={`tel:${telefonHref}`} class="footer-contact-link">
          {/* Material Icons — call */}
          <svg class="footer-contact-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
          </svg>
          <span>{telefon}</span>
        </a>
        <div class="footer-social">
          <a
            href={social.facebook}
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook Ziołowa Akademia"
          >
            {/* Material Design Icons — Facebook · glyph 24×24, hit 48×48 */}
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
            </svg>
          </a>
          <a
            href={social.instagram}
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Ziołowa Akademia"
          >
            {/* Material Design Icons — Instagram · glyph 24×24, hit 48×48 */}
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
              <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {rok} Ziołowa Akademia · Monika Wierus-Wieczorek</span>
      <span class="footer-muted">Wszelkie prawa zastrzeżone.</span>
    </div>
  </div>

  {/* Wielki wordmark domykający stronę. Przycinanie siedzi na własnym
      wrapperze, a nie na stopce — inaczej `overflow: hidden` obcinałby
      falbankę wystającą ponad górną krawędź. */}
  <div class="footer-wordmark-clip" aria-hidden="true">
    <div class="footer-wordmark">Ziołowa Akademia</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--white);
    /* Górna krawędź to falbanka (klasa `falbanka-gora` w global.css):
       brzuszki w kolorze stopki wychodzą ponad nią, na sekcje powyżej.
       Stąd BRAK overflow:hidden tutaj — przycinanie wordmarku ma własny
       wrapper, żeby nie obciąć falbanki. */
    --bump: 100px;
    --falbanka-kolor: var(--ink);
    padding-top: 100px;
    /* zapas na blur + home indicator */
    padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
  }

  .footer-wordmark-clip {
    overflow: hidden;   /* napis jest szerszy niż ekran i celowo wychodzi poza kadr */
  }

  .footer-top {
    display: grid;
    /* Logo | Nawigacja | Kontakt — kolumny na środku wysokości logo */
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.15fr);
    column-gap: 48px;
    align-items: center;
    padding-bottom: 48px;
  }

  /* pole dotyku 44px */
  .footer-logo { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; }
  .footer-logo img {
    display: block;
    height: auto;
    width: min(240px, 60vw);
    /* czarna kreska → biel na ciemnym tle stopki */
    filter: brightness(0) invert(1);
  }

  /* gap: 0, bo odstęp robi teraz padding samych linków —
     inaczej sumowałby się z nim i lista by się rozjechała */
  .footer-col { display: flex; flex-direction: column; gap: 0; }
  .footer-col h3 {
    font-family: var(--font);
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: rgba(255, 255, 255, .55);
    font-weight: var(--weight-ui);
    margin: 0 0 8px;
    line-height: 1.3;
  }
  /* Link ma 26px tekstu — za mało na palec. padding-block rozciąga pole
     dotyku do 44px, nie ruszając wyglądu samego napisu. */
  .footer-col a {
    font-weight: 600;
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--duration-quick) var(--ease-smooth-out);
  }
  .footer-col a:hover { color: var(--lime); }
  .footer-contact-link {
    gap: 12px;
  }
  .footer-contact-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: block;
    color: var(--lime);
  }
  .footer-muted { color: rgba(255, 255, 255, .55); }

  .footer-social {
    display: flex;
    align-items: center;
    /* 16px między glyphami 24×24 — pole dotyku wychodzi poza box (nie wlicza się w gap) */
    gap: 16px;
    margin-top: 8px;
  }
  .footer-social-link {
    position: relative;
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px !important; /* nadpisuje .footer-col a (44px) */
    padding: 0;
    display: inline-grid !important;
    place-items: center;
    color: var(--lime);
    background: transparent;
    transition: color var(--duration-quick) var(--ease-smooth-out),
                filter var(--duration-quick) var(--ease-smooth-out);
  }
  /* hit 48×48 wokół glypha 24×24 — bez wpływu na gap */
  .footer-social-link::after {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .footer-social-link:hover {
    color: var(--lime);
    background: transparent;
    filter: brightness(1.15);
  }
  .footer-social-link svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, .14);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: .9rem;
    color: rgba(255, 255, 255, .55);
  }

  /* Wielki wordmark domykający stronę.
     Fill jest SOLIDNY (nie biel z opacity) — przy kryciu nakładające się
     glify („ł" na „o") sumowały się w ciemniejszą plamę. Ten kolor to
     dokładny odpowiednik dawnej bieli 10% na tle --ink.
     Napis jest szerszy niż ekran i celowo wychodzi poza kadr —
     przycina go `.footer-wordmark-clip`. */
  .footer-wordmark {
    margin-top: 72px;
    white-space: nowrap;
    /* Napis gaśnie ku dołowi zamiast urywać się na twardo. Wcześniej robił to
       ujemny margines + przycięcie, ale zostawiało to widoczne ścięcie glifów.
       Maska działa na kolorze, więc znika też pod nią samo tło stopki. */
    mask-image: linear-gradient(to bottom, #000 35%, transparent 92%);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 92%);
    /* Box przyjmuje szerokość tekstu i jest centrowany transformem.
       `margin-inline: auto` by nie zadziałało — dla boxa szerszego od
       rodzica marginesy auto zerują się i tekst kleiłby się do lewej. */
    width: max-content;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-naglowek);
    font-size: clamp(4rem, 19vw, 16rem);
    font-weight: var(--weight-display);
    line-height: .8;
    letter-spacing: -0.02em;     /* luźniej — „ł" nie wchodzi już na „o" */
    color: oklch(0.355 0.024 140.4);
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 28px;
      justify-items: center;
      text-align: center;
    }
    .footer-col { align-items: center; }
    .footer-col a { margin-inline: auto; }
    .footer-social { justify-content: center; }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .footer { --bump: 64px; padding-top: 64px; }
    .footer-wordmark { margin-top: 40px; }
  }
</style>
