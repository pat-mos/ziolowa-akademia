---
// Układ 1:1 jak w oryginale: jedna duża karta (lewa kolumna) + dwie małe
// (prawa kolumna, jedna nad drugą). Każda karta ma inny kolor tła.
const opinie = [
  {
    text: 'Córka wróciła z warsztatów bardzo zadowolona i od razu opowiadała o ziołach, zapachach oraz tym, co sama zrobiła. Pani Monika stworzyła ciepłą atmosferę, a wiedzę przekazała dzieciom w prosty, ciekawy i angażujący sposób. Polecam serdecznie.',
    autor: 'Adrianna',
    rola: 'Rodzic',
  },
  {
    text: 'Syn po warsztatach z Panią Moniką był naprawdę podekscytowany. Podobało mu się, że mógł poznawać rośliny wszystkimi zmysłami i działać samodzielnie. To wartościowe zajęcia, które łączą naukę, zabawę i kontakt z naturą.',
    autor: 'Mateusz',
    rola: 'Rodzic',
  },
  {
    text: 'Warsztaty z Panią Moniką były bardzo przyjemnym doświadczeniem. W spokojnej atmosferze poznałam wiele ciekawych ziół, ich zapachy, właściwości i codzienne zastosowanie. Wyszłam z zajęć z nową wiedzą i dużą inspiracją. Chętnie wrócę ponownie.',
    autor: 'Zuzanna',
    rola: 'Uczestniczka zajęć',
  },
];
const klasy = ['big', 's1', 's2'];
---
<section class="section opinie">
  <div class="container">
    <h2 class="section-title">Opinie o zajęciach</h2>

    <div class="reviews">
      {opinie.map((o, i) => (
        <blockquote class:list={['opinia', klasy[i]]}>
          <div class="stars" aria-label="5 na 5 gwiazdek">
            {Array.from({ length: 5 }).map(() => (
              <svg class="star" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2.5l2.74 6.42 6.96.66-5.26 4.66 1.56 6.76L12 17.77l-5.99 3.23 1.56-6.76-5.26-4.66 6.96-.66L12 2.5z" />
              </svg>
            ))}
          </div>
          <p>{o.text}</p>
          <footer>
            <strong>{o.autor}</strong>
            <span>{o.rola}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  /* Siatka: lewa kolumna = duża karta (2 wiersze), prawa = 2 małe karty */
  .reviews {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: auto auto;
    gap: 24px;
  }
  .opinia.big { grid-column: 1; grid-row: 1 / span 2; }
  .opinia.s1  { grid-column: 2; grid-row: 1; }
  .opinia.s2  { grid-column: 2; grid-row: 2; }

  .opinia {
    margin: 0;
    border-radius: 32px;
    display: flex;
    flex-direction: column;
  }
  /* tła: pastele mocno rozcieńczone — subtelniej niż FAQ-level wash */
  .opinia.big {
    background: color-mix(in oklch, var(--pastel-limonka) 28%, var(--white));
    padding: 40px;
  }
  .opinia.s1 {
    background: color-mix(in oklch, var(--pastel-szczaw) 28%, var(--white));
    padding: 32px;
  }
  .opinia.s2 {
    background: color-mix(in oklch, var(--pastel-blawatek) 28%, var(--white));
    padding: 32px;
  }

  .stars {
    display: flex;
    gap: 4px;
    color: oklch(0.72 0.14 85);
    opacity: 0.55;
    margin-bottom: 20px;
  }
  .star { display: block; flex-shrink: 0; }

  .opinia p { color: var(--ink); font-weight: var(--weight-emphasis); }
  /* duży cytat: lh prose (≥1.4) — wieloliniowy tekst, nie display */
  .opinia.big p {
    font-size: clamp(1.4rem, 1.8vw, 1.75rem);
    line-height: var(--lh-prose);
    letter-spacing: -0.01em;
  }
  .opinia.s1 p, .opinia.s2 p { font-size: var(--text-lead); line-height: var(--lh-body); }

  .opinia footer {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    flex-direction: column;
  }
  .opinia footer strong { font-weight: var(--weight-emphasis); font-size: var(--text-body); color: var(--ink); }
  .opinia footer span { color: var(--muted); font-size: .9rem; }

  @media (max-width: 900px) {
    .reviews { grid-template-columns: 1fr; }
    .opinia.big, .opinia.s1, .opinia.s2 {
      grid-column: 1;
      grid-row: auto;
    }
  }
  @media (max-width: 520px) {
    .opinia.big { padding: 28px; }
    .opinia.s1,
    .opinia.s2 { padding: 24px; }
    .opinia.big p { font-size: 1.2rem; line-height: var(--lh-prose); }
  }
</style>
