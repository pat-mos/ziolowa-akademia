  .od-price-amount { font-size: 2.4rem; font-weight: 900; color: var(--ink); letter-spacing: -0.02em; }
  .od-price-unit { font-size: 1.05rem; font-weight: 700; color: var(--muted); }
  .od-price-note { margin: 8px 0 0; color: var(--muted); font-size: .88rem; line-height: 1.5; }
  .modal-close {
    position: absolute; top: 24px; right: 24px;   /* min. 24px od krawędzi */
    z-index: 2;
    width: 44px; height: 44px; border-radius: 50%; border: none;
    background: var(--cream); cursor: pointer;
    color: var(--ink);
    display: grid; place-items: center;
    transition: background .15s ease, transform .1s ease;
  }
  .modal-close:active { transform: scale(.96); }
  .modal-close:hover { background: var(--line); }

  @media (max-width: 900px) {
    /* `margin-inline: auto` jest tu KONIECZNE — samo max-width zostawia stos
       przy lewej krawędzi, podczas gdy tytuł sekcji i reszta strony centrują
       się. To była pozostałość po starym układzie siatki (stąd zniknęło
       `grid-template-columns` — .cards jest teraz flexem, więc nic nie robiło).
       560px zamiast 420px: przy ~840px szerokości karta na 420px wyglądała
       jak zagubiony pasek na środku pustej sekcji. */
    .cards { max-width: 560px; margin-inline: auto; }
  }

  /* Treść karty do lewej ma sens tylko obok zdjęcia. Po złożeniu kolumn wraca
     na środek, tak jak Wartości, Oferta i FAQ na tej szerokości.
     Ten blok MUSI stać po regułach .offer-body — mają tę samą specyficzność,
     więc decyduje kolejność w pliku. */
  @media (max-width: 900px) {
