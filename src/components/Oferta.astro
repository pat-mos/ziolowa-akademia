// (usunięto podgląd z powielaniem — poniżej są już prawdziwe oferty z materiałów)
---
<section class="section oferta" id="oferta">
  <div class="container">
    <span class="eyebrow">Oferta</span>
    <h2 class="section-title">Zajęcia dopasowane do uczestników</h2>

    <div class="tabs" role="tablist">
      {tabs.map((t, i) => (
        <button class:list={['tab', { active: i === 0 }]} data-tab={t.id} role="tab">{t.label}</button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div class:list={['panel', { active: i === 0 }]} data-panel={t.id}>
        {t.puste ? (
          <div class="cards cards--single">
            <article class="offer-card is-placeholder" style="--i:0">
             <div class="offer-inner">
              <div class="offer-photo ph-img" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
              </div>
              <div class="offer-body">
                <h3>Wkrótce</h3>
                <p>Przygotowujemy ofertę dla tej grupy — już niedługo pojawią się tu nowe zajęcia. Zapraszamy wkrótce!</p>
              </div>
             </div>
            </article>
          </div>
        ) : (
          <div class="cards stos">
              {t.items.map((it, i) => (
                <article
                  class="offer-card"
                  style={`--i:${i}`}
                  tabindex="0"
                  role="button"
                  data-title={it.title}
                  data-subtitle={it.subtitle || ''}
                >
                 <div class="offer-inner">
                  <div class="offer-photo">
                    <Image src={it.img} alt={it.title} widths={[600, 1000]} sizes="(max-width: 900px) 90vw, 520px" />
                  </div>
                  <div class="offer-body">
                    {it.tags && (
                      <ul class="offer-tags">
                        {it.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    )}
                    <h3>{it.title}</h3>
                    <p>{it.text}</p>
                    <span class="offer-link">
                      Dowiedz się więcej
                      <span class="offer-link-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>

                  {/* Ukryta, bogata treść pokazywana w popoverze */}
                  <template class="offer-detail">
                    {it.program ? (
                      <div class="od">
                        {it.intro.map((p) => <p class="od-lead">{p}</p>)}

                        <h4 class="od-h">Program warsztatów</h4>
                        <ul class="od-program">
                          {it.program.map((s) => (
                            <li><strong>{s.h}</strong><span>{s.p}</span></li>
                          ))}
                        </ul>

                        {it.options && (
                          <div class="od-opts-wrap">
                            <h4 class="od-h">Do wyboru</h4>
                            <ul class="od-options">
                              {it.options.map((o) => (
                                <li>
                                  <div class="od-opt-head">
                                    <strong>{o.h}</strong>
                                    <span class="od-opt-price">{o.price}</span>
                                  </div>
                                  <span>{o.p}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        <div class="od-cols">
                          <div>
                            <h4 class="od-h">Informacje</h4>
                            <ul class="od-info">
                              {it.info.map(([k, v]) => (
                                <li><span class="od-k">{k}</span><span class="od-v">{v}</span></li>
                              ))}
                            </ul>
                          </div>
                          <div>
                            <h4 class="od-h">Zapewniamy</h4>
                            <ul class="od-check">
                              {it.provided.map((p) => <li>{p}</li>)}
                            </ul>
                          </div>
                        </div>

                        <h4 class="od-h">Po warsztatach dzieci</h4>
                        <ul class="od-check">
                          {it.benefits.map((b) => <li>{b}</li>)}
                        </ul>

                        {/* cena zawsze na samym dole */}
                        <div class="od-price">
                          <div class="od-price-main">
                            <span class="od-price-amount">{it.price}</span>
                            <span class="od-price-unit">{it.priceUnit}</span>
                          </div>
                          <p class="od-price-note">{it.priceNote}</p>
                        </div>
                      </div>
                    ) : (
                      <div class="od">
                        {(it.full || '').split('\n\n').map((p) => <p class="od-lead">{p}</p>)}
                      </div>
                    )}
                  </template>
                 </div>
                </article>
              ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<!-- Okno (modal) z rozwiniętym opisem zajęć -->
<div class="modal" id="offer-modal" aria-hidden="true">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal-close" data-close aria-label="Zamknij">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <div class="modal-scroll">
      <div class="modal-content">
        <h3 id="modal-title"></h3>
        <p class="modal-subtitle" id="modal-subtitle"></p>
        <div class="modal-body"></div>
      </div>
    </div>
    <div class="modal-foot">
      <a href="#kontakt" class="btn btn-lime" data-close>Zapytaj o termin</a>
    </div>
  </div>
</div>

<script>
  const tabs = [...document.querySelectorAll('.tab')];
  const panels = document.querySelectorAll('.panel');
  let currentIndex = 0;
  tabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => {
      if (idx === currentIndex) return;
      const dir = idx > currentIndex ? 1 : -1; // w prawo / w lewo
      currentIndex = idx;
      const id = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active', 'slide-in'));
      tab.classList.add('active');
      const panel = document.querySelector(`[data-panel="${id}"]`) as HTMLElement | null;
      if (panel) {
        // panel wjeżdża z tej strony, w którą nawigujemy
        panel.style.setProperty('--from', dir * 34 + 'px');
        // `slide-in` włącza animację tylko przy przełączeniu, nie przy starcie strony
        panel.classList.add('active', 'slide-in');
      }
    });
  });

  // --- Modal ---
  import Lenis from 'lenis';

  // Smooth scroll (bezwładność jak na stronie) wewnątrz popovera.
  // Osobna instancja Lenisa na kontenerze treści; żyje tylko gdy modal otwarty.
  let modalLenis = null;
  let modalRaf = null;
  function startModalScroll(m) {
    const wrapper = m.querySelector('.modal-scroll');
    const content = m.querySelector('.modal-content');
    if (!wrapper || !content || modalLenis) return;
    modalLenis = new Lenis({ wrapper, content, duration: 1.1 });
    const loop = (time) => {
      modalLenis?.raf(time);
      modalRaf = requestAnimationFrame(loop);
    };
    modalRaf = requestAnimationFrame(loop);
  }
  function stopModalScroll() {
    if (modalRaf) cancelAnimationFrame(modalRaf);
    modalRaf = null;
    modalLenis?.destroy();
    modalLenis = null;
  }

  const modal = document.getElementById('offer-modal');
  const titleEl = modal.querySelector('#modal-title');
  const subtitleEl = modal.querySelector('#modal-subtitle') as HTMLElement;
  const bodyEl = modal.querySelector('.modal-body');

  // Element, na który oddajemy focus po zamknięciu — inaczej po Escape lądowałby
  // na początku strony zamiast wrócić do klikniętej karty.
  let modalTrigger: HTMLElement | null = null;

  // Uwięzienie Tab w oknie: aria-modal nie blokuje fokusu, więc bez tego
  // klawiatura wychodziłaby na treść pod spodem.
  function trapTab(e: KeyboardEvent) {
    if (e.key !== 'Tab') return;
    const focusable = modal.querySelectorAll<HTMLElement>(
      'a[href], button, textarea, input, [tabindex]:not([tabindex="-1"])'
    );
    const lista = [...focusable].filter((el) => el.offsetParent !== null);
    if (!lista.length) return;
    const pierwszy = lista[0];
    const ostatni = lista[lista.length - 1];
    if (e.shiftKey && document.activeElement === pierwszy) {
      e.preventDefault(); ostatni.focus();
    } else if (!e.shiftKey && document.activeElement === ostatni) {
      e.preventDefault(); pierwszy.focus();
    }
  }

  function openModal(card) {
    modalTrigger = card;
    titleEl.textContent = card.dataset.title;
    const sub = card.dataset.subtitle || '';
    subtitleEl.textContent = sub;
    subtitleEl.style.display = sub ? 'block' : 'none';
    // Klonujemy bogatą treść z ukrytego szablonu karty.
    const detail = card.querySelector('.offer-detail');
    bodyEl.innerHTML = detail ? detail.innerHTML : '';
    const scroller = modal.querySelector('.modal-scroll');
    if (scroller) scroller.scrollTop = 0;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    window.lenis?.stop();
    startModalScroll(modal);
    modal.addEventListener('keydown', trapTab);
    // Focus do okna — na przycisk zamknięcia, żeby czytnik ogłosił dialog.
    (modal.querySelector('.modal-close') as HTMLElement | null)?.focus();
  }
  function closeModal() {
    if (!modal.classList.contains('open')) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    window.lenis?.start();
    stopModalScroll();
    modal.removeEventListener('keydown', trapTab);
    modalTrigger?.focus();
    modalTrigger = null;
  }

  document.querySelectorAll('.offer-card:not(.is-placeholder)').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); }
    });
  });
  modal.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', closeModal)
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Karuzela (strzałki + fade brzegów) zniknęła — karty stoją teraz w stosie
  // i przyklejają się przy przewijaniu. Efekt jest w całości CSS-owy, patrz
  // `.stos .offer-card` w <style> poniżej. Nie ma tu nic do sterowania.
</script>

<style>
  .tabs {
    display: flex; flex-wrap: wrap; gap: 10px; margin: 32px 0 40px;
    justify-content: center;   /* wyśrodkowane pod nagłówkiem */
  }
  /* Chipsy: każdy ZAWSZE ma swój własny pastel — kolor jest tożsamością grupy,
     nie stanem. Aktywny nie zmienia barwy, tylko dostaje pierścień wokół
     (odstęp robi pierwszy, biały cień). Dzięki temu zaznaczenie czyta się
     nawet dla kogoś, kto nie rozróżnia tych kolorów. */
  .tab:nth-child(1) { --chip: var(--pastel-limonka); }
  .tab:nth-child(2) { --chip: var(--pastel-szczaw); }
  .tab:nth-child(3) { --chip: var(--pastel-piasek); }
  .tab:nth-child(4) { --chip: var(--pastel-lipa); }

  .tab {
    padding: 14px 28px; border-radius: var(--radius-pill);
    border: none; background: var(--chip); color: var(--ink);
    font-family: var(--font); font-weight: 800; font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 0 0 0 var(--white), 0 0 0 0 var(--chip);
    transition: box-shadow .18s ease, transform .1s ease, filter .15s ease;
  }
  .tab:hover { filter: brightness(.96); }
  .tab:active { transform: scale(.96); }
  .tab.active { box-shadow: 0 0 0 4px var(--white), 0 0 0 7px var(--chip); }

  .panel { display: none; }
  .panel.active { display: block; }
  /* Animacja TYLKO przy realnym przełączeniu zakładki (klasę dodaje JS).
     Bez tego panel wjeżdżał z fade przy pierwszym renderze strony. */
  .panel.active.slide-in { animation: panelIn var(--duration-fast) var(--ease-smooth-out) both; }
  /* wejście kierunkowe — z boku, w stronę nawigacji (zmienna --from ustawiana w JS) */
  @keyframes panelIn {
    from { opacity: 0; transform: translateX(var(--from, 24px)); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel.active.slide-in { animation: none; }
  }

  /* --- Stos kart ---
     Karty leżą jedna pod drugą i każda przykleja się coraz niżej: karta nr 0
     zatrzymuje się przy --stos-gora, nr 1 o --stos-krok niżej itd. Kolejna
     wjeżdża na poprzednią i zostaje z niej widoczny tylko pasek — rosną piętra.
     Wszystko robi CSS; --i wstrzykuje Astro w atrybucie style każdej karty.
     `overflow: clip` na .cards psułoby sticky, więc go tu nie ma. */
  .cards {
    --stos-gora: 96px;    /* gdzie zatrzymuje się pierwsza karta */
    --stos-krok: 26px;    /* o ile niżej każda następna — grubość piętra */
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  /* Uwaga na koniec stosu: gdy ostatnia karta dojedzie na miejsce, wszystkie
     zbiegają się w jeden punkt i paski pięter znikają naraz. To wynika z
     reguły, że sticky nie wypchnie karty poza kontener — a karty są równej
     wysokości, więc limit wypada dla nich w tym samym miejscu. Wygląda to
     dobrze, bo w tym momencie ostatnia karta i tak zasłania resztę.
     Próbowałem to odsunąć zapasem na dole i NIE RÓB TEGO: padding stosu nic
     nie daje (sticky liczy content box), a margines ostatniej karty psuje
     jeszcze bardziej — karta ucieka wtedy ponad przyklejone poprzedniczki. */
  .stos .offer-card {
    position: sticky;
    top: calc(var(--stos-gora) + var(--i) * var(--stos-krok));
    /* Późniejsza karta ma być NAD wcześniejszą. Bez tego malowałyby się
       w kolejności DOM i nowa wsuwałaby się pod spód. */
    z-index: calc(var(--i) + 1);
  }
  /* Stos ma sens tylko wtedy, gdy karta mieści się w oknie — inaczej
     przyklejanie chowałoby jej dół.
     Skąd 600px: karta ma ~400px, a najniższa przykleja się na 174px
     (96 + 3 × 26), czyli potrzeba ~575px. Próg 720px był ustawiony, gdy karty
     miały jeszcze 469–605px, i po skróceniu opisów gasił stos na zwykłych
     laptopach z oknem ~700px. Jeśli karta znów urośnie, tę liczbę trzeba
     podnieść razem z nią. */
  @media (max-height: 600px), (max-width: 900px) {
    .stos .offer-card { position: static; }
  }

  /* Każda karta w innym pastelu. Jedna płaszczyzna, bez pastelowej ramki
     wokół wnętrza — reszta strony (FAQ, opinie) też ma karty jednolite. */
  .offer-card:nth-child(1) { --karta: var(--pastel-limonka); }
  .offer-card:nth-child(2) { --karta: var(--pastel-szczaw); }
  .offer-card:nth-child(3) { --karta: var(--pastel-piasek); }
  .offer-card:nth-child(4) { --karta: var(--pastel-lipa); }

  .offer-card {
    /* `in oklab`, NIE `in oklch`. Biel to oklch(1 0 0) — formalnie hue 0 —
       więc mieszanie w oklch interpoluje także odcień i ściąga limonkę
       (hue 122) w stronę różu. oklab jest prostokątny: rozbiela, nie kręci
       odcieniem. */
    background: color-mix(in oklab, var(--karta, var(--pastel-limonka)) 42%, var(--white));
    border-radius: 24px;
    cursor: pointer;
    transition: box-shadow .2s ease;
  }
  .offer-inner {
    padding: 32px;
    display: grid;
    grid-template-columns: 38% 1fr;   /* więcej miejsca na opis */
    gap: 36px;
    align-items: center;
  }
  .offer-photo img,
  .offer-photo {
    width: 100%;
    border-radius: 12px;
    display: block;
  }
  .offer-photo img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* czysta czerń 10% — barwiony obrys czytałby się jak brud na krawędzi */
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  @media (max-width: 900px) {
    .offer-inner { grid-template-columns: 1fr; gap: 22px; padding: 18px; }
    /* Wyśrodkowanie treści karty jest NIŻEJ, pod regułami .offer-body —
       tamte ustawiają align-items: flex-start przy tej samej specyficzności,
       więc override postawiony tutaj by przegrał kolejnością. */
  }
  /* focus (klawiatura) zawsze; hover tylko dla myszy.
     Focus siedzi na `outline`, a nie na obrysie karty — obrys zniknął razem
     z ramką, a zaznaczenie klawiaturą musi zostać widoczne. */
  .offer-card:focus-visible {
    outline: 3px solid var(--lime-dark);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .offer-card:hover {
      box-shadow: 0 0 0 4px rgba(200, 233, 76, .25);
      transform: translateY(-2px);
    }
    /* strzałka rusza w prawo */
    .offer-card:hover .offer-link-arrow { transform: translateX(4px); }
    /* wciśnięcie przy myszy — zachowaj uniesienie, dodaj scale */
    .offer-card:hover:active { transform: translateY(-2px) scale(.96); }
  }
  /* bez ruchu przy „ogranicz animacje" — zostaje sam obrys/poświata */
  @media (prefers-reduced-motion: reduce) {
    .offer-card,
    .offer-link-arrow { transition: none; }
    .offer-card:hover { transform: none; }
    .offer-card:hover .offer-link-arrow { transform: none; }
  }
  .offer-card:active { transform: scale(.96); }
  .offer-card.is-placeholder:active { transform: none; }
  .offer-body { display: flex; flex-direction: column; align-items: flex-start; }
  /* Tagi: krótkie metadane (wiek, czas) — białe pigułki jak u nich */
  .offer-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .offer-tags li {
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-pill);
    padding: 8px 20px;
    font-size: .82rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .offer-body h3 { font-size: 1.9rem; margin-bottom: 12px; line-height: 1.15; }
  .offer-body p {
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.65;
    /* 62ch to nadal komfortowa długość wiersza — powyżej ~75ch oko gubi
       początek następnej linii. */
    max-width: 62ch;
  }
  /* margin-top:auto dopycha link do dołu — równy poziom na wszystkich kartach */
  .offer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 14px;
    font-weight: 700;
    color: var(--ink);
    width: fit-content;
  }
  /* strzałka przesuwa się przy najechaniu na kartę */
  .offer-link-arrow {
    display: inline-block;
    transition: transform .2s cubic-bezier(.2, .8, .2, 1);
  }

  /* Karta-placeholder „Wkrótce" dla pustych zakładek — wygląd jak karty dzieci */
  .offer-card.is-placeholder { cursor: default; }
  .offer-card.is-placeholder:hover { transform: none; box-shadow: none; }
  .ph-img {
    aspect-ratio: 4 / 3;
    display: grid; place-items: center;
    background: linear-gradient(135deg, #eef2ec, #e2ebe0);
    color: #aebfa7;
  }
  .ph-img svg { width: 48px; height: 48px; display: block; }
  .offer-card.is-placeholder .offer-body h3 { color: var(--ink); }

  /* --- Modal --- */
  .modal {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center; padding: 24px;
    opacity: 0; pointer-events: none;
    transition: opacity var(--duration-quick) var(--ease-smooth-out);   /* zamknięcie: szybciej */
    will-change: opacity;
  }
  .modal.open { opacity: 1; pointer-events: auto; transition: opacity var(--duration-fast) var(--ease-smooth-out); }
  .modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(20,30,18,.55); backdrop-filter: blur(3px);
  }
  .modal-dialog {
    position: relative; z-index: 1;
    background: var(--white); border-radius: var(--radius);
    max-width: 640px; width: 100%; max-height: 85vh;
    display: flex; flex-direction: column;   /* treść + przypięta stopka */
    overflow: hidden;                        /* zaokrąglone rogi trzymają kształt */
    box-shadow: 0 30px 80px rgba(0,0,0,.3);
    transform: translateY(18px) scale(.96);
    transition: transform var(--duration-quick) var(--ease-smooth-out);   /* zamknięcie: szybciej */
  }
  /* przewijalny obszar treści */
  .modal-scroll {
    overflow-y: auto;
    padding: 40px 40px 24px;
    -webkit-overflow-scrolling: touch;
  }
  /* przypięta biała belka z przyciskiem */
  .modal-foot {
    flex-shrink: 0;
    padding: 20px 40px;
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .modal.open .modal-dialog { transform: none; transition: transform var(--duration-fast) var(--ease-smooth-out); }
  @media (prefers-reduced-motion: reduce) {
    .modal, .modal-dialog { transition: none; }
    .modal-dialog { transform: none; }
  }
  /* padding-right: 48px = X (40px szer. przy right:24) + 24px odstępu od tytułu */
  .modal-dialog h3 { font-size: 1.6rem; margin-bottom: 2px; padding-right: 48px; }
