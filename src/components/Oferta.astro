     Bez tego panel wjeżdżał z fade przy pierwszym renderze strony. */
  .panel.active.slide-in { animation: panelIn .32s cubic-bezier(.2, .8, .2, 1) both; }
  /* wejście kierunkowe — z boku, w stronę nawigacji (zmienna --from ustawiana w JS) */
  @keyframes panelIn {
    from { opacity: 0; transform: translateX(var(--from, 24px)); }
    to   { opacity: 1; transform: none; }
