---
import { Image } from 'astro:assets';
import img1 from '../assets/img/oferta-1.jpeg';
import img2 from '../assets/img/oferta-2.jpeg';
import img3 from '../assets/img/oferta-3.jpeg';

// Dane oferty. Pole `full` to dłuższy tekst pokazywany w oknie (modalu)
// po kliknięciu karty — do swobodnej edycji/rozbudowy.
const tabs = [
  {
    id: 'dzieci',
    label: 'Dla dzieci',
    puste: false,
    items: [
      {
        img: img1,
        title: 'Mały zielarz',
        subtitle: 'Odkrywamy Moc Ziół',
        tags: ['od 5 lat', '1 godzina'],
        text: 'Pachnące warsztaty ziołowe — dzieci poznają świat roślin, ich zapachy i smaki, które czekają tuż obok nas.',
        intro: [
          'Mali Zielarze – Odkrywamy Moc Ziół to pachnące, pełne odkryć warsztaty, podczas których dzieci poznają niezwykły świat ziół i roślin. Uczestnicy przekonają się, że wiele cennych roślin rośnie tuż obok nas – na łąkach, w ogrodach i parkach, a natura kryje w sobie mnóstwo zapachów, kolorów i smaków.',
          'To zajęcia, które łączą naukę z praktycznym działaniem i świetną zabawą. Dzieci uczą się poprzez doświadczenie – oglądają, dotykają, wąchają i samodzielnie tworzą własne mieszanki ziołowe. Warsztaty rozwijają ciekawość świata, uważność oraz uczą, jak w bezpieczny i świadomy sposób korzystać z darów natury.',
        ],
        program: [
          { h: 'Poznajemy świat ziół', p: 'Wspólnie odkrywamy najpopularniejsze zioła, ich zapach, wygląd i zastosowanie. Rozmawiamy o tym, gdzie rosną i dlaczego od wieków są obecne w naszym życiu.' },
          { h: 'Tworzymy własną herbatkę ziołową', p: 'Każde dziecko komponuje swoją własną mieszankę herbatki ziołowej, którą następnie pakuje do ozdobnego opakowania i oznacza własnoręcznie wykonaną etykietą.' },
          { h: 'Zioła wszystkimi zmysłami', p: 'Poprzez zabawę i proste doświadczenia dzieci poznają rośliny za pomocą wzroku, dotyku i zapachu. Uczą się uważnej obserwacji i odkrywania świata przyrody wszystkimi zmysłami.' },
          { h: 'Zioła w domowej apteczce', p: 'Rozmawiamy o tym, jak rośliny od wieków wykorzystywano w domach oraz jak mądrze i bezpiecznie korzystać z ich właściwości.' },
        ],
        info: [
          ['Wiek uczestników', 'od 5 lat'],
          ['Czas trwania', '1 godzina'],
          ['Liczba uczestników', 'minimum 10 osób'],
        ],
        provided: [
          'wszystkie materiały potrzebne do wykonania mieszanki ziołowej',
          'suszone zioła',
          'opakowania na herbatę i etykiety',
          'opiekę doświadczonego edukatora',
        ],
        price: '40 zł',
        priceUnit: '/ uczestnik',
        priceNote: 'W przypadku większych grup oraz stałej współpracy warunki ustalane są indywidualnie.',
        benefits: [
          'poznają najpopularniejsze zioła i ich właściwości',
          'nauczą się rozpoznawać rośliny za pomocą zmysłów',
          'dowiedzą się, jak świadomie i bezpiecznie korzystać z darów natury',
          'rozwiną ciekawość, uważność i spostrzegawczość',
          'zabiorą do domu własnoręcznie przygotowaną mieszankę herbatki ziołowej',
        ],
      },
      {
        img: img2,
        title: 'Mali Ogrodnicy',
        subtitle: 'Odkrywamy Świat Roślin',
        tags: ['od 4 lat', '60 minut'],
        text: 'Pełne zielonych odkryć warsztaty — dzieci poznają tajemnice ogrodu i samodzielnie sadzą własną roślinkę.',
        intro: [
          'Mali Ogrodnicy – Odkrywamy Świat Roślin to pełne zielonych odkryć warsztaty, podczas których dzieci poznają fascynujący świat roślin i tajemnice ogrodu. Uczestnicy przekonają się, jak rosną kwiaty i zioła, czego potrzebują do życia oraz dlaczego warto dbać o otaczającą nas przyrodę.',
          'To zajęcia, które łączą naukę z praktycznym działaniem i świetną zabawą. Dzieci uczą się poprzez doświadczenie – obserwują, dotykają, wąchają, badają i samodzielnie sadzą własne rośliny. Warsztaty rozwijają ciekawość świata, uczą odpowiedzialności oraz pokazują, że pielęgnowanie roślin może być prawdziwą przygodą.',
        ],
        program: [
          { h: 'Poznajemy świat roślin', p: 'Wspólnie odkrywamy różnorodne gatunki ziół i kwiatów. Rozpoznajemy ich zapachy, kolory i kształty oraz rozmawiamy o tym, czego rośliny potrzebują, aby zdrowo rosnąć.' },
          { h: 'Świat pod lupą', p: 'Za pomocą lup sprawdzamy, co kryje się w ziemi i jakie organizmy w niej żyją. Dzieci przekonają się, że nawet niewielki fragment ogrodu skrywa wiele fascynujących tajemnic.' },
          { h: 'Praca prawdziwego ogrodnika', p: 'Uczestnicy poznają podstawowe narzędzia ogrodnicze i dowiedzą się, do czego służą oraz jak bezpiecznie z nich korzystać podczas pielęgnacji roślin.' },
          { h: 'Sadzimy własną roślinkę', p: 'Każde dziecko samodzielnie posadzi wybraną sadzonkę zioła lub kwiatu, podleje ją i oznaczy własnoręcznie przygotowaną etykietą. Gotową roślinę zabierze do domu, aby obserwować jej wzrost i dalej o nią dbać.' },
        ],
        info: [
          ['Wiek uczestników', 'od 4 lat'],
          ['Czas trwania', '60 minut'],
          ['Liczba uczestników', 'minimum 10 osób'],
        ],
        provided: [
          'wszystkie materiały potrzebne do wykonania warsztatów',
          'lupy i narzędzia ogrodnicze',
          'sadzonki ziół i kwiatów',
          'ziemię i doniczki',
          'mazaki oraz etykiety',
          'opiekę doświadczonego edukatora',
        ],
        price: '40 zł',
        priceUnit: '/ uczestnik',
        priceNote: 'W przypadku większych grup oraz stałej współpracy warunki ustalane są indywidualnie.',
        benefits: [
          'poznają podstawowe gatunki ziół i kwiatów',
          'dowiedzą się, czego potrzebują rośliny do wzrostu',
          'poznają podstawowe narzędzia ogrodnicze i ich zastosowanie',
          'rozwiną ciekawość, uważność oraz umiejętność obserwacji przyrody',
          'nauczą się samodzielnie sadzić i pielęgnować rośliny',
          'zabiorą do domu własnoręcznie posadzoną roślinkę',
        ],
      },
      {
        img: img3,
        title: 'Zielarsko-Herbaciane Przygody',
        subtitle: 'Odkrywamy świat herbat i ziół',
        tags: ['od 4 lat', 'ok. 60 minut'],
        text: 'Dzieci odkrywają świat herbat i ziół, komponują własną mieszankę i biorą udział w efektownym eksperymencie.',
        intro: [
          'Zielarsko-Herbaciane Przygody to wyjątkowe warsztaty edukacyjne, podczas których dzieci odkrywają fascynujący świat herbat, ziół i roślin. Wspólnie poznajemy bogactwo natury wszystkimi zmysłami – oglądamy, dotykamy, wąchamy i smakujemy, przekonując się, że w filiżance herbaty kryje się wiele niezwykłych historii.',
          'Podczas warsztatów dzieci dowiadują się, skąd pochodzi herbata, czym różni się od naparu ziołowego oraz poznają najpopularniejsze zioła i ich zastosowanie. Zajęcia łączą edukację, eksperymenty i twórczą zabawę, rozwijając ciekawość, kreatywność oraz uważność na otaczającą przyrodę.',
        ],
        program: [
          { h: 'Odkrywamy świat herbat i ziół', p: 'Dzieci poznają różne rodzaje herbat oraz najpopularniejsze zioła wykorzystywane do przygotowywania aromatycznych naparów. Dowiadują się, skąd pochodzą, jak wyglądają oraz czym różni się prawdziwa herbata od naparu ziołowego.' },
          { h: 'Tworzymy własną herbatkę', p: 'Każdy uczestnik komponuje własną mieszankę ziół, kwiatów i suszonych owoców. Gotową herbatkę pakuje do ekologicznego opakowania i ozdabia własnoręcznie przygotowaną etykietą.' },
          { h: 'Magiczna herbata – pokaz zmiany kolorów', p: 'Dzieci uczestniczą w niezwykłym eksperymencie z naparem z kwiatów klitorii ternateńskiej, nazywanej niebieską herbatą. Obserwują, jak po dodaniu kilku kropel soku z cytryny napar zmienia kolor z niebieskiego na fioletowy lub różowy. To efektowne doświadczenie pokazuje, że przyroda potrafi zaskakiwać, a jednocześnie w prosty sposób wyjaśnia zjawiska zachodzące w świecie roślin.' },
          { h: 'Degustacja naparów', p: 'Na zakończenie wspólnie degustujemy aromatyczne napary owocowe i ziołowe, poznając ich smak, zapach oraz sposoby przygotowania.' },
        ],
        info: [
          ['Wiek uczestników', 'od 4 lat'],
          ['Czas trwania', 'około 60 minut'],
          ['Liczba uczestników', 'minimum 10 osób'],
        ],
        provided: [
          'wszystkie materiały potrzebne do warsztatów',
          'bogaty wybór herbat liściastych, ziół, kwiatów i suszonych owoców',
          'opakowania i etykiety',
          'materiały plastyczne',
          'degustację naparów',
          'opiekę doświadczonego prowadzącego',
        ],
        price: '40 zł',
        priceUnit: '/ uczestnik',
        priceNote: 'W przypadku większych grup oraz stałej współpracy warunki ustalane są indywidualnie.',
        benefits: [
          'poznają świat herbat i ziół',
          'nauczą się rozróżniać herbatę od naparu ziołowego',
          'samodzielnie przygotują własną mieszankę herbacianą',
          'wezmą udział w efektownym eksperymencie z niebieską herbatą',
          'rozwiną zmysły oraz kreatywność',
          'zabiorą do domu własnoręcznie przygotowaną herbatkę',
        ],
      },
      {
        img: img1,
        title: 'Botaniczna Pracownia Natury',
        subtitle: 'Kreatywne Warsztaty Przyrodnicze',
        tags: ['od 4 lat', '50 minut'],
        text: 'Twórcze warsztaty inspirowane przyrodą z elementami hortiterapii — dzieci tworzą własną botaniczną pamiątkę.',
        intro: [
          'Botaniczna Pracownia Natury to twórcze warsztaty inspirowane przyrodą, podczas których dzieci odkrywają piękno świata roślin, łącząc kreatywną zabawę z poznawaniem botaniki. Uczestnicy przekonają się, że natura może być niewyczerpanym źródłem inspiracji, a z pozornie zwyczajnych darów przyrody można stworzyć wyjątkowe dzieła.',
          'Warsztaty zostały wzbogacone o elementy hortiterapii, czyli zajęcia wykorzystujące kontakt z roślinami i materiałami naturalnymi do wspierania rozwoju dziecka. Obcowanie z naturą pobudza wszystkie zmysły, pomaga wyciszyć emocje, rozwija uważność, koncentrację oraz kreatywność. Praca z naturalnymi materiałami daje dzieciom poczucie sprawczości, zachęca do samodzielnego odkrywania świata i buduje wrażliwość na otaczającą przyrodę.',
          'To zajęcia, które łączą edukację przyrodniczą z twórczym działaniem. Dzieci uczą się poprzez obserwację, dotyk, zapach i kreatywne eksperymentowanie z naturalnymi materiałami. Poznają różnorodne rośliny, ich wygląd, faktury oraz niezwykłe właściwości.',
        ],
        program: [
          { h: 'Poznajemy botaniczne skarby', p: 'Wspólnie odkrywamy różnorodne rośliny oraz naturalne materiały, takie jak mech, szyszki, gałązki, liście, kwiaty i nasiona. Dzieci poznają ich wygląd, strukturę oraz dowiadują się, jaką rolę pełnią w przyrodzie.' },
          { h: 'Natura wszystkimi zmysłami', p: 'Dzieci poznają bogactwo faktur, kolorów i zapachów natury. Poprzez zabawę i doświadczenia rozwijają zmysły, uczą się uważnej obserwacji oraz odkrywają, jak kontakt z przyrodą wpływa na nasze samopoczucie.' },
          { h: 'Tworzymy własne dzieło inspirowane naturą', p: 'Każdy uczestnik wybiera jedną z przygotowanych propozycji i tworzy własną, niepowtarzalną botaniczną pamiątkę.' },
        ],
        options: [
          { h: 'Dwa botaniczne magnesy na lodówkę', price: '40 zł', p: 'Dzieci tworzą własne kompozycje z wykorzystaniem mchu, szyszek, suszonych kwiatów, liści, nasion oraz innych naturalnych elementów dekoracyjnych.' },
          { h: 'Dekoracyjna drewniana ramka na zdjęcie', price: '45 zł', p: 'Uczestnicy ozdabiają ramkę naturalnymi materiałami, tworząc wyjątkową dekorację inspirowaną światem roślin.' },
          { h: 'Dwa mydełka glicerynowe', price: '40 zł', p: 'Dzieci wykonują własne pachnące mydełka glicerynowe z dodatkami inspirowanymi naturą, poznając właściwości wybranych składników roślinnych.' },
          { h: 'Tabliczka florencka i ziołowy woreczek zapachowy', price: '40 zł', p: 'Uczestnicy tworzą dekoracyjną tabliczkę zapachową oraz własny woreczek wypełniony aromatycznymi ziołami. To wyjątkowa praca, która łączy piękno, zapach i kontakt z naturalnymi materiałami.' },
          { h: 'Odciski roślin w glinie', price: '40 zł', p: 'Dwa własnoręcznie wykonane dzieła. Dzieci tworzą trwałe pamiątki z wykorzystaniem liści i roślin, odciskając ich wzory w glinie. Podczas pracy poznają różnorodność kształtów i struktur występujących w świecie przyrody.' },
        ],
        info: [
          ['Wiek uczestników', 'od 4 lat'],
          ['Czas trwania', '50 minut'],
          ['Liczba uczestników', 'minimum 10 osób'],
        ],
        provided: [
          'wszystkie materiały potrzebne do wykonania wybranej pracy',
          'naturalne elementy dekoracyjne: mech, szyszki, liście, kwiaty, nasiona i zioła',
          'glinę, mydło glicerynowe oraz materiały plastyczne',
          'opiekę doświadczonego edukatora',
        ],
        price: '40–45 zł',
        priceUnit: '/ uczestnik',
        priceNote: 'Cena zależy od wybranej pracy. W przypadku większych grup oraz stałej współpracy warunki ustalane są indywidualnie.',
        benefits: [
          'poznają różnorodne rośliny i naturalne materiały',
          'dowiedzą się, jaką rolę rośliny odgrywają w przyrodzie',
          'rozwiną kreatywność, wyobraźnię oraz zdolności manualne',
          'będą doskonalić koncentrację, cierpliwość i uważność poprzez kontakt z naturą',
          'rozwiną zmysły, doświadczając różnorodnych faktur, zapachów i kolorów',
          'nauczą się wykorzystywać dary przyrody w twórczy sposób',
          'odkryją, że kontakt z naturą sprzyja wyciszeniu i dobremu samopoczuciu',
          'zabiorą do domu własnoręcznie wykonaną wyjątkową pamiątkę',
        ],
      },
    ],
  },
  { id: 'dorosli', label: 'Dla dorosłych', puste: true, items: [] },
  { id: 'firmy', label: 'Dla firm', puste: true, items: [] },
];

// (usunięto podgląd z powielaniem — poniżej są już prawdziwe oferty z materiałów)
---
<section class="section oferta" id="oferta">
  <div class="container">
    <span class="eyebrow">Oferta</span>
    <h2 class="section-title">Zajęcia dopasowane do uczestników</h2>

    <div class="tabs" role="tablist">
      {tabs.map((t, i) => (
        <button class:list={['tab', { active: i === 0 }]} data-tab={t.id} role="tab">{t.label}</button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div class:list={['panel', { active: i === 0 }]} data-panel={t.id}>
        {t.puste ? (
          <div class="cards cards--single">
            <article class="offer-card is-placeholder">
              <div class="ph-img" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
              </div>
              <div class="offer-body">
                <h3>Wkrótce</h3>
                <p>Przygotowujemy ofertę dla tej grupy — już niedługo pojawią się tu nowe zajęcia. Zapraszamy wkrótce!</p>
              </div>
            </article>
          </div>
        ) : (
          <div class="carousel at-start">
            <button class="car-arrow car-prev" aria-label="Poprzednie">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
            </button>
            <div class="cards" data-track>
              {t.items.map((it) => (
                <article
                  class="offer-card"
                  tabindex="0"
                  role="button"
                  data-title={it.title}
                  data-subtitle={it.subtitle || ''}
                >
                  <Image src={it.img} alt={it.title} widths={[400, 700]} sizes="360px" />
                  <div class="offer-body">
                    {it.tags && (
                      <ul class="offer-tags">
                        {it.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    )}
                    <h3>{it.title}</h3>
                    <p>{it.text}</p>
                    <span class="offer-link">
                      Dowiedz się więcej
                      <span class="offer-link-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>

                  {/* Ukryta, bogata treść pokazywana w popoverze */}
                  <template class="offer-detail">
                    {it.program ? (
                      <div class="od">
                        {it.intro.map((p) => <p class="od-lead">{p}</p>)}

                        <h4 class="od-h">Program warsztatów</h4>
                        <ul class="od-program">
                          {it.program.map((s) => (
                            <li><strong>{s.h}</strong><span>{s.p}</span></li>
                          ))}
                        </ul>

                        {it.options && (
                          <div class="od-opts-wrap">
                            <h4 class="od-h">Do wyboru</h4>
                            <ul class="od-options">
                              {it.options.map((o) => (
                                <li>
                                  <div class="od-opt-head">
                                    <strong>{o.h}</strong>
                                    <span class="od-opt-price">{o.price}</span>
                                  </div>
                                  <span>{o.p}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        <div class="od-cols">
                          <div>
                            <h4 class="od-h">Informacje</h4>
                            <ul class="od-info">
                              {it.info.map(([k, v]) => (
                                <li><span class="od-k">{k}</span><span class="od-v">{v}</span></li>
                              ))}
                            </ul>
                          </div>
                          <div>
                            <h4 class="od-h">Zapewniamy</h4>
                            <ul class="od-check">
                              {it.provided.map((p) => <li>{p}</li>)}
                            </ul>
                          </div>
                        </div>

                        <h4 class="od-h">Po warsztatach dzieci</h4>
                        <ul class="od-check">
                          {it.benefits.map((b) => <li>{b}</li>)}
                        </ul>

                        {/* cena zawsze na samym dole */}
                        <div class="od-price">
                          <div class="od-price-main">
                            <span class="od-price-amount">{it.price}</span>
                            <span class="od-price-unit">{it.priceUnit}</span>
                          </div>
                          <p class="od-price-note">{it.priceNote}</p>
                        </div>
                      </div>
                    ) : (
                      <div class="od">
                        {(it.full || '').split('\n\n').map((p) => <p class="od-lead">{p}</p>)}
                      </div>
                    )}
                  </template>
                </article>
              ))}
            </div>
            <button class="car-arrow car-next" aria-label="Następne">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </button>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<!-- Okno (modal) z rozwiniętym opisem zajęć -->
<div class="modal" id="offer-modal" aria-hidden="true">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal-close" data-close aria-label="Zamknij">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <div class="modal-scroll">
      <div class="modal-content">
        <h3 id="modal-title"></h3>
        <p class="modal-subtitle" id="modal-subtitle"></p>
        <div class="modal-body"></div>
      </div>
    </div>
    <div class="modal-foot">
      <a href="#kontakt" class="btn btn-lime" data-close>Zapytaj o termin</a>
    </div>
  </div>
</div>

<script>
  const tabs = [...document.querySelectorAll('.tab')];
  const panels = document.querySelectorAll('.panel');
  let currentIndex = 0;
  tabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => {
      if (idx === currentIndex) return;
      const dir = idx > currentIndex ? 1 : -1; // w prawo / w lewo
      currentIndex = idx;
      const id = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active', 'slide-in'));
      tab.classList.add('active');
      const panel = document.querySelector(`[data-panel="${id}"]`) as HTMLElement | null;
      if (panel) {
        // panel wjeżdża z tej strony, w którą nawigujemy
        panel.style.setProperty('--from', dir * 34 + 'px');
        // `slide-in` włącza animację tylko przy przełączeniu, nie przy starcie strony
        panel.classList.add('active', 'slide-in');
      }
    });
  });

  // --- Modal ---
  import Lenis from 'lenis';

  // Smooth scroll (bezwładność jak na stronie) wewnątrz popovera.
  // Osobna instancja Lenisa na kontenerze treści; żyje tylko gdy modal otwarty.
  let modalLenis = null;
  let modalRaf = null;
  function startModalScroll(m) {
    const wrapper = m.querySelector('.modal-scroll');
    const content = m.querySelector('.modal-content');
    if (!wrapper || !content || modalLenis) return;
    modalLenis = new Lenis({ wrapper, content, duration: 1.1 });
    const loop = (time) => {
      modalLenis?.raf(time);
      modalRaf = requestAnimationFrame(loop);
    };
    modalRaf = requestAnimationFrame(loop);
  }
  function stopModalScroll() {
    if (modalRaf) cancelAnimationFrame(modalRaf);
    modalRaf = null;
    modalLenis?.destroy();
    modalLenis = null;
  }

  const modal = document.getElementById('offer-modal');
  const titleEl = modal.querySelector('#modal-title');
  const subtitleEl = modal.querySelector('#modal-subtitle') as HTMLElement;
  const bodyEl = modal.querySelector('.modal-body');

  function openModal(card) {
    titleEl.textContent = card.dataset.title;
    const sub = card.dataset.subtitle || '';
    subtitleEl.textContent = sub;
    subtitleEl.style.display = sub ? 'block' : 'none';
    // Klonujemy bogatą treść z ukrytego szablonu karty.
    const detail = card.querySelector('.offer-detail');
    bodyEl.innerHTML = detail ? detail.innerHTML : '';
    const scroller = modal.querySelector('.modal-scroll');
    if (scroller) scroller.scrollTop = 0;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    window.lenis?.stop();
    startModalScroll(modal);
  }
  function closeModal() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    window.lenis?.start();
    stopModalScroll();
  }

  document.querySelectorAll('.offer-card:not(.is-placeholder)').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); }
    });
  });
  modal.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', closeModal)
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // --- Karuzela: strzałki + fade zależne od pozycji przewinięcia ---
  document.querySelectorAll('.carousel').forEach((car) => {
    const track = car.querySelector('[data-track]') as HTMLElement | null;
    if (!track) return;
    const step = () => {
      const card = track.querySelector('.offer-card') as HTMLElement | null;
      const gap = 24;
      return card ? card.offsetWidth + gap : 360;
    };
    // ustaw klasy at-start / at-end (sterują fade i strzałkami)
    const update = () => {
      // tolerancja 8px — drobne drgnięcie scrolla (np. snap) nie przełączy stanu
      const atStart = track.scrollLeft <= 8;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      car.classList.toggle('at-start', atStart);
      car.classList.toggle('at-end', atEnd);
    };
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    // przelicz też po przełączeniu zakładki (panel bywa ukryty przy starcie)
    document.querySelectorAll('.tab').forEach((t) =>
      t.addEventListener('click', () => setTimeout(update, 60))
    );
    update();

    car.querySelector('.car-prev')?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' })
    );
    car.querySelector('.car-next')?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' })
    );
  });
</script>

<style>
  .tabs {
