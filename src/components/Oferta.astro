  .od-program { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .od-program li { display: flex; flex-direction: column; gap: 3px; }
  .od-program strong { color: var(--ink); font-weight: 800; }
  .od-program span { color: var(--muted); font-size: .95rem; line-height: 1.55; }

  /* „Do wyboru" — warianty prac z własnymi cenami */
  .od-options { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .od-options li { display: flex; flex-direction: column; gap: 4px; }
  .od-opt-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .od-opt-head strong { color: var(--ink); font-weight: 800; }
  .od-opt-price {
    flex-shrink: 0;
    background: var(--cream);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
    font-weight: 800;
    font-size: .85rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .od-options li > span { color: var(--muted); font-size: .95rem; line-height: 1.55; }

  .od-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 520px) { .od-cols { grid-template-columns: 1fr; gap: 8px; } }

  .od-info { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .od-info li { display: flex; flex-direction: column; }
