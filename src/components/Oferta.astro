// (usunięto podgląd z powielaniem — poniżej są już prawdziwe oferty z materiałów)
---
<section class="section oferta" id="oferta">
  <div class="container">
    <span class="eyebrow">Oferta</span>
    <h2 class="section-title">Zajęcia dopasowane do uczestników</h2>

    <div class="tabs" role="tablist" aria-label="Grupy zajęć">
      {tabs.map((t, i) => (
        <button
          class:list={['tab', { active: i === 0 }]}
          data-tab={t.id}
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >{t.label}</button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div
        class:list={['panel', { active: i === 0 }]}
        data-panel={t.id}
        role="tabpanel"
        id={`panel-${t.id}`}
        aria-labelledby={`tab-${t.id}`}
        hidden={i !== 0}
      >
        {t.puste ? (
          <div class="cards cards--single">
            <article class="offer-card is-placeholder" style="--i:0">
             <div class="offer-inner">
              <div class="offer-photo ph-img" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
              </div>
              <div class="offer-body">
                <h3>Wkrótce</h3>
                <p>Przygotowujemy ofertę dla tej grupy — już niedługo pojawią się tu nowe zajęcia. Zapraszamy wkrótce!</p>
              </div>
             </div>
            </article>
          </div>
        ) : (
          <div class="cards stos">
              {t.items.map((it, i) => (
                <article
                  class="offer-card"
                  style={`--i:${i}`}
                  data-title={it.title}
                  data-subtitle={it.subtitle || ''}
                >
                 <div class="offer-inner">
                  {/* LEWA: tytuł, opis, cena, przycisk */}
                  <div class="offer-lewa">
                    <div class="offer-naglowek">
                      {it.tags && (
                        <ul class="offer-tags">
                          {it.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                      )}
                      <h3>{it.title}</h3>
                      <p>{it.text}</p>
                    </div>

                  </div>

                  {/* PRAWA: jaśniejszy box z listą — jak `pricing-bottom` */}
                  <div class="offer-prawa">
                    <p class="offer-lista-tytul">Co zapewniamy:</p>
                    <ul class="offer-lista">
                      {(it.provided || []).slice(0, 6).map((poz) => (
                        <li>
                          <span class="offer-ptaszek" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="currentColor"><path d="M12.9,32.1c5.4,3.6,10.1,8,14.1,13.1c-0.9-0.1-1.8-0.2-2.7-0.3c7.3-9.3,15.5-17.7,24.6-25.2c1.8-1.5,4.3,1.4,2.5,2.9c-8.8,7.3-16.8,15.4-23.8,24.4c-0.7,0.9-2.1,0.8-2.7-0.3c-3.8-4.8-8.2-9-13.3-12.4C9.9,33.3,11.2,31,12.9,32.1z" /></svg>
                          </span>
                          <span>{poz}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="offer-stopka">
                      {it.price ? (
                        <p class="offer-cena">
                          <span class="offer-kwota">{it.price}</span>
                          <span class="offer-jednostka">{it.priceUnit}</span>
                        </p>
                      ) : (
                        <p class="offer-cena">
                          <span class="offer-wkrotce">W przygotowaniu</span>
                        </p>
                      )}
                      {it.wkrotce ? (
                        <a class="btn btn-lime offer-cta" href="#kontakt">Zapytaj o termin</a>
                      ) : (
                        <button class="btn btn-lime offer-cta" type="button">Zobacz szczegóły</button>
                      )}
                    </div>
                  </div>

                  {/* Ukryta, bogata treść pokazywana w popoverze */}
                  <template class="offer-detail">
                    {it.program ? (
                      <div class="od">
                        {it.intro.map((p) => <p class="od-lead">{p}</p>)}

                        <h4 class="od-h">Program warsztatów</h4>
                        <ul class="od-program">
                          {it.program.map((s) => (
                            <li><strong>{s.h}</strong><span>{s.p}</span></li>
                          ))}
                        </ul>

                        {it.options && (
                          <div class="od-opts-wrap">
                            <h4 class="od-h">Do wyboru</h4>
                            <ul class="od-options">
                              {it.options.map((o) => (
                                <li>
                                  <div class="od-opt-head">
                                    <strong>{o.h}</strong>
                                    <span class="od-opt-price">{o.price}</span>
                                  </div>
                                  <span>{o.p}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        <div class="od-cols">
                          <div>
                            <h4 class="od-h">Informacje</h4>
                            <ul class="od-info">
                              {it.info.map(([k, v]) => (
                                <li><span class="od-k">{k}</span><span class="od-v">{v}</span></li>
                              ))}
                            </ul>
                          </div>
                          <div>
                            <h4 class="od-h">Zapewniamy</h4>
                            <ul class="od-check">
                              {it.provided.map((p) => <li>{p}</li>)}
                            </ul>
                          </div>
                        </div>

                        <h4 class="od-h">Po warsztatach dzieci</h4>
                        <ul class="od-check">
                          {it.benefits.map((b) => <li>{b}</li>)}
                        </ul>

                        {/* cena zawsze na samym dole */}
                        <div class="od-price">
                          <div class="od-price-main">
                            <span class="od-price-amount">{it.price}</span>
                            <span class="od-price-unit">{it.priceUnit}</span>
                          </div>
                          <p class="od-price-note">{it.priceNote}</p>
                        </div>
                      </div>
                    ) : (
                      <div class="od">
                        {(it.full || '').split('\n\n').map((p) => <p class="od-lead">{p}</p>)}
                      </div>
                    )}
                  </template>
                 </div>
                </article>
              ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<!-- Okno (modal) z rozwiniętym opisem zajęć -->
<div class="modal" id="offer-modal" aria-hidden="true" inert>
  <div class="modal-backdrop" data-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal-close" data-close aria-label="Zamknij">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <div class="modal-scroll">
      <div class="modal-content">
        <h3 id="modal-title"></h3>
        <p class="modal-subtitle" id="modal-subtitle"></p>
        <div class="modal-body"></div>
      </div>
    </div>
    <div class="modal-foot">
      <a href="#kontakt" class="btn btn-lime" data-close>Zapytaj o termin</a>
    </div>
  </div>
</div>

<script>
  const tabs = [...document.querySelectorAll<HTMLElement>('.tab')];
  const panels = document.querySelectorAll<HTMLElement>('.panel');
  let currentIndex = 0;

  function aktywujTab(idx: number, dir = 1) {
    currentIndex = idx;
    const tab = tabs[idx];
    const id = tab.getAttribute('data-tab');
    tabs.forEach((t, i) => {
      const on = i === idx;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => {
      p.classList.remove('active', 'slide-in');
      p.hidden = true;
    });
    const panel = document.querySelector(`[data-panel="${id}"]`) as HTMLElement | null;
    if (panel) {
      panel.style.setProperty('--from', dir * 12 + 'px');
      panel.classList.add('active', 'slide-in');
      panel.hidden = false;
    }
  }

  tabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => {
      if (idx === currentIndex) return;
      const dir = idx > currentIndex ? 1 : -1;
      aktywujTab(idx, dir);
    });
    tab.addEventListener('keydown', (e) => {
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      e.preventDefault();
      const dir = next > idx ? 1 : -1;
      aktywujTab(next, dir);
      tabs[next].focus();
    });
  });

  // --- Modal ---
  import Lenis from 'lenis';

  // Smooth scroll (bezwładność jak na stronie) wewnątrz popovera.
  // Osobna instancja Lenisa na kontenerze treści; żyje tylko gdy modal otwarty.
  let modalLenis = null;
  let modalRaf = null;
  function startModalScroll(m) {
    const wrapper = m.querySelector('.modal-scroll');
    const content = m.querySelector('.modal-content');
    if (!wrapper || !content || modalLenis) return;
    modalLenis = new Lenis({ wrapper, content, duration: 1.1 });
    const loop = (time) => {
      modalLenis?.raf(time);
      modalRaf = requestAnimationFrame(loop);
    };
    modalRaf = requestAnimationFrame(loop);
  }
  function stopModalScroll() {
    if (modalRaf) cancelAnimationFrame(modalRaf);
    modalRaf = null;
    modalLenis?.destroy();
    modalLenis = null;
  }

  const modal = document.getElementById('offer-modal');
  const titleEl = modal.querySelector('#modal-title');
  const subtitleEl = modal.querySelector('#modal-subtitle') as HTMLElement;
  const bodyEl = modal.querySelector('.modal-body');

  // Element, na który oddajemy focus po zamknięciu — inaczej po Escape lądowałby
  // na początku strony zamiast wrócić do klikniętej karty.
  let modalTrigger: HTMLElement | null = null;

  // Uwięzienie Tab w oknie: aria-modal nie blokuje fokusu, więc bez tego
  // klawiatura wychodziłaby na treść pod spodem.
  function trapTab(e: KeyboardEvent) {
    if (e.key !== 'Tab') return;
    const focusable = modal.querySelectorAll<HTMLElement>(
      'a[href], button, textarea, input, [tabindex]:not([tabindex="-1"])'
    );
    const lista = [...focusable].filter((el) => el.offsetParent !== null);
    if (!lista.length) return;
    const pierwszy = lista[0];
    const ostatni = lista[lista.length - 1];
    if (e.shiftKey && document.activeElement === pierwszy) {
      e.preventDefault(); ostatni.focus();
    } else if (!e.shiftKey && document.activeElement === ostatni) {
      e.preventDefault(); pierwszy.focus();
    }
  }

  function openModal(card) {
    // focus wraca na przycisk w karcie, nie na całą kartę
    modalTrigger = card.querySelector('.offer-cta') || card;
    titleEl.textContent = card.dataset.title;
    const sub = card.dataset.subtitle || '';
    subtitleEl.textContent = sub;
    subtitleEl.style.display = sub ? 'block' : 'none';
    // Klonujemy bogatą treść z ukrytego szablonu karty.
    const detail = card.querySelector('.offer-detail');
    bodyEl.innerHTML = detail ? detail.innerHTML : '';
    const scroller = modal.querySelector('.modal-scroll');
    if (scroller) scroller.scrollTop = 0;
    // Okno przejmuje kolor otwartej oferty — spójność karty i szczegółów.
    const kolor = getComputedStyle(card).getPropertyValue('--karta').trim();
    modal.style.setProperty('--karta', kolor);
    // Ciemny wariant tego samego odcienia — kreski i checkmarki w oknie.
    const ciemny = getComputedStyle(card).getPropertyValue('--karta-ciemna').trim();
    modal.style.setProperty('--akcent', ciemny);
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    modal.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
    window.lenis?.stop();
    startModalScroll(modal);
    modal.addEventListener('keydown', trapTab);
    // Focus do okna — na przycisk zamknięcia, żeby czytnik ogłosił dialog.
    (modal.querySelector('.modal-close') as HTMLElement | null)?.focus();
  }
  function closeModal() {
    if (!modal.classList.contains('open')) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    modal.setAttribute('inert', '');
    document.body.style.overflow = '';
    window.lenis?.start();
    stopModalScroll();
    modal.removeEventListener('keydown', trapTab);
    modalTrigger?.focus();
    modalTrigger = null;
  }

  // Okno otwiera przycisk w karcie, a nie cała karta. Wcześniej klikalna była
  // karta (role="button" + tabindex) — teraz w środku jest prawdziwy <button>,
  // więc zagnieżdżanie dwóch klikalnych warstw byłoby błędem dostępności.
  document.querySelectorAll('.offer-card:not(.is-placeholder) .offer-cta').forEach((cta) => {
    cta.addEventListener('click', () => {
      const card = cta.closest('.offer-card');
      if (card) openModal(card);
    });
  });
  modal.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', closeModal)
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Karuzela (strzałki + fade brzegów) zniknęła — karty stoją teraz w stosie
  // i przyklejają się przy przewijaniu. Efekt jest w całości CSS-owy, patrz
  // `.stos .offer-card` w <style> poniżej. Nie ma tu nic do sterowania.
</script>

<style>
  .tabs {
    display: flex; flex-wrap: wrap; gap: 12px; margin: 40px 0;
    justify-content: center;   /* wyśrodkowane pod nagłówkiem */
  }
  /* Mobile: chipy w jednym rzędzie, przewijane w poziomie */
  @media (max-width: 720px) {
    .tabs {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 10px;
      margin-inline: calc(-1 * max(24px, env(safe-area-inset-left)));
      margin-block: 32px 28px;
      padding-inline: max(24px, env(safe-area-inset-left))
                      max(24px, env(safe-area-inset-right));
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tab {
      flex: 0 0 auto;
      padding: 12px 22px;
      white-space: nowrap;
    }
  }
  /* Chipsy: każdy ZAWSZE ma swój własny pastel — kolor jest tożsamością grupy,
     nie stanem. Aktywny nie zmienia barwy, tylko dostaje pierścień wokół
     (odstęp robi pierwszy, biały cień). Dzięki temu zaznaczenie czyta się
     nawet dla kogoś, kto nie rozróżnia tych kolorów. */
  /* Hybryda miód / mech / glina / pyłek — te same tokeny co karty i kafelki. */
  .tab:nth-child(1) { --chip: var(--pastel-limonka); } /* miód */
  .tab:nth-child(2) { --chip: var(--pastel-szczaw); }  /* mech */
  .tab:nth-child(3) { --chip: var(--pastel-piasek); }  /* glina */
  .tab:nth-child(4) { --chip: var(--pastel-lipa); }    /* pyłek */

  .tab {
    padding: 14px 28px; border-radius: var(--radius-pill);
    border: none; background: var(--chip); color: var(--ink);
    font-family: var(--font); font-weight: var(--weight-ui); font-size: var(--text-body);
    cursor: pointer;
    box-shadow: 0 0 0 0 var(--white), 0 0 0 0 var(--chip);
    transition: box-shadow var(--duration-quick) var(--ease-smooth-out),
                transform var(--duration-quick) var(--ease-smooth-out),
                filter var(--duration-quick) var(--ease-smooth-out);
  }
  .tab:hover { filter: brightness(.96); }
  .tab:active { transform: scale(var(--scale-large)); }
  .tab.active { box-shadow: 0 0 0 4px var(--white), 0 0 0 7px var(--chip); }

  .panel { display: none; }
  .panel.active { display: block; }
  /* Animacja TYLKO przy realnym przełączeniu zakładki (klasę dodaje JS).
     Bez tego panel wjeżdżał z fade przy pierwszym renderze strony. */
  .panel.active.slide-in { animation: panelIn var(--duration-fast) var(--ease-smooth-out) both; }
  /* wejście kierunkowe — z boku, w stronę nawigacji (zmienna --from ustawiana w JS) */
  @keyframes panelIn {
    from { opacity: 0; transform: translateX(var(--from, var(--distance-medium))); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel.active.slide-in { animation: none; }
  }

  /* --- Stos kart ---
     Karty leżą jedna pod drugą i każda przykleja się coraz niżej: karta nr 0
     zatrzymuje się przy --stos-gora, nr 1 o --stos-krok niżej itd. Kolejna
     wjeżdża na poprzednią i zostaje z niej widoczny tylko pasek — rosną piętra.
     Wszystko robi CSS; --i wstrzykuje Astro w atrybucie style każdej karty.
     `overflow: clip` na .cards psułoby sticky, więc go tu nie ma. */
  .cards {
    --stos-gora: 96px;    /* gdzie zatrzymuje się pierwsza karta */
    --stos-krok: 26px;    /* o ile niżej każda następna — grubość piętra */
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  /* Uwaga na koniec stosu: gdy ostatnia karta dojedzie na miejsce, wszystkie
     zbiegają się w jeden punkt i paski pięter znikają naraz. To wynika z
     reguły, że sticky nie wypchnie karty poza kontener — a karty są równej
     wysokości, więc limit wypada dla nich w tym samym miejscu. Wygląda to
     dobrze, bo w tym momencie ostatnia karta i tak zasłania resztę.
     Próbowałem to odsunąć zapasem na dole i NIE RÓB TEGO: padding stosu nic
     nie daje (sticky liczy content box), a margines ostatniej karty psuje
     jeszcze bardziej — karta ucieka wtedy ponad przyklejone poprzedniczki. */
  .stos .offer-card {
    position: sticky;
    top: calc(var(--stos-gora) + var(--i) * var(--stos-krok));
    /* Późniejsza karta ma być NAD wcześniejszą. Bez tego malowałyby się
       w kolejności DOM i nowa wsuwałaby się pod spód. */
    z-index: calc(var(--i) + 1);
  }
  /* Stos ma sens tylko wtedy, gdy karta mieści się w oknie — inaczej
     przyklejanie chowałoby jej dół.
     Skąd 600px: karta ma ~400px, a najniższa przykleja się na 174px
     (96 + 3 × 26), czyli potrzeba ~575px. Próg 720px był ustawiony, gdy karty
     miały jeszcze 469–605px, i po skróceniu opisów gasił stos na zwykłych
     laptopach z oknem ~700px. Jeśli karta znów urośnie, tę liczbę trzeba
     podnieść razem z nią. */
  @media (max-height: 600px), (max-width: 900px) {
    .stos .offer-card { position: static; }
  }

  /* --- Karta w stylu „pricing" z tinylo ---
     Zewnętrzna karta w pastelu: outer = inner + padding (16 + 10 = 26).
     Lewa przezroczysta z opisem, prawa na półprzezroczystej bieli. */
  /* Każda oferta ma parę: jasny pastel (tło karty) i ciemny wariant TEGO
     SAMEGO odcienia (chmurki, akcenty w oknie). Ciemny nie powstaje przez
     mieszanie z --ink — ten jest zielony i ściągał każdy kolor w zieleń. */
  .offer-card:nth-child(1) { --karta: var(--pastel-limonka); --karta-ciemna: oklch(0.52 0.11 82);  }  /* miód */
  .offer-card:nth-child(2) { --karta: var(--pastel-szczaw);  --karta-ciemna: oklch(0.50 0.10 155); }  /* mech */
  .offer-card:nth-child(3) { --karta: var(--pastel-piasek);  --karta-ciemna: oklch(0.52 0.10 48);  }  /* glina */
  /* pyłek rozcieńczony — przy sticky nie zlewa się z pełną gliną powyżej */
  .offer-card:nth-child(4) {
    --karta: color-mix(in oklch, var(--pastel-lipa) 52%, var(--white));
    --karta-ciemna: oklch(0.52 0.08 35);
  }  /* pyłek */

  .offer-card {
    background: var(--karta, var(--pastel-limonka));
    border-radius: 26px;
    padding: 10px;
    transition: box-shadow var(--duration-quick) var(--ease-smooth-out);
  }
  .offer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    /* HUG: kolumny wysokie na tyle, ile mają treści — bez rozciągania
       prawego boksu na pełną wysokość karty. */
    align-items: start;
  }

  /* Lewa kolumna — sam opis */
  .offer-lewa { padding: 24px 24px 20px; }
  .offer-lewa h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #000;
    margin-bottom: 10px;
  }
  .offer-lewa p { color: rgb(51, 51, 51); font-size: var(--text-body); line-height: var(--lh-body); }

  /* Prawa kolumna — półprzezroczysta biel na kolorze karty */
  .offer-prawa {
    background: rgba(255, 255, 255, .55);
    border-radius: 16px;
    padding: 24px;
  }
  .offer-lista-tytul {
    font-size: var(--text-body);
    font-weight: var(--weight-ui);
    color: #000;
    margin-bottom: 16px;
  }
  .offer-lista {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .offer-lista li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: .92rem;
    color: rgb(51, 51, 51);
    line-height: 1.45;
  }
  /* Ptaszek w chmurce (a nie w kole) — ten sam kształt co falbanki na stronie.
     Tło w kolorze karty, więc każda oferta ma spójne ikony. */
  .offer-ptaszek {
    flex-shrink: 0;
    width: 24px;
    height: 22px;
    margin-top: 1px;
    display: grid;
    place-items: center;
    /* Ciemny wariant koloru oferty — ten sam odcień, niższa jasność.
       Czysty pastel byłby niewidoczny (prawy boks to ten sam pastel
       rozbielony bielą, kontrast wychodził 1.12). */
    background: var(--karta-ciemna);
    /* chmurka: nieregularne wybrzuszenia zamiast koła */
    border-radius: 62% 38% 55% 45% / 55% 60% 40% 45%;
    color: var(--white);
  }
  .offer-ptaszek svg { width: 15px; height: 15px; display: block; }

  /* Cena + przycisk — grupowanie spacją, bez separatora */
  .offer-stopka {
    padding-top: 8px;
  }
  .offer-cena {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 12px;
  }
  .offer-kwota {
    font-family: var(--font-naglowek);
    font-size: 2.2rem;
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #000;
    font-variant-numeric: tabular-nums;
  }
  .offer-jednostka { font-size: .92rem; font-weight: var(--weight-body); color: rgb(51, 51, 51); }
  /* Oferta jeszcze bez ceny — w miejscu kwoty stoi etykieta */
  .offer-wkrotce {
    font-family: var(--font-naglowek);
    font-size: 1.5rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    color: rgb(51, 51, 51);
  }

  /* CTA w karcie — te same btn-lime (błysk), tylko pełna szerokość */
  .offer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    padding: 11px 28px;
    font-size: .95rem;
  }
  .offer-cta:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  /* Wspólny próg ~900: stos, dwie kolumny i centrowanie kart. */
  @media (max-width: 900px) {
