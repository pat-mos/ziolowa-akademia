---
// Górna nawigacja w formie "pigułki" na tle hero.
const social = {
  facebook: 'https://www.facebook.com/ziolowaakademia25',
  instagram: 'https://www.instagram.com/ziolowa.akademia/',
};
---
<header class="nav">
  <div class="nav-pill">
    <a href="#top" class="nav-logo" aria-label="Ziołowa Akademia — strona główna">
      <img
        src="/img/logo-mark.png"
        alt=""
        class="nav-logo-img"
        width="52"
        height="51"
      />
    </a>
    <nav class="nav-links">
      <a href="#o-mnie">O mnie</a>
      <a href="#oferta">Zajęcia</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
    <a href="#kontakt" class="btn btn-lime nav-cta">Zapisz się</a>

    {/* Hamburger — tylko na telefonie. Obie ikony siedzą w DOM i przenikają
        się nawzajem, dzięki czemu przejście działa w obie strony bez JS-a. */}
    <button
      class="nav-burger"
      id="nav-burger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span class="nav-burger-ic nav-burger-ic--menu" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </span>
      <span class="nav-burger-ic nav-burger-ic--zamknij" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </span>
    </button>
  </div>

  {/* Panel mobilny — poza pigułką, żeby mógł się rozwijać pod nią */}
  <div class="nav-panel" id="nav-panel">
    <a href="#o-mnie">O mnie</a>
    <a href="#oferta">Zajęcia</a>
    <a href="#kontakt">Kontakt</a>
    <div class="nav-panel-social">
      <a
        href={social.facebook}
        class="nav-social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook Ziołowa Akademia"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
          <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
        </svg>
      </a>
      <a
        href={social.instagram}
        class="nav-social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Ziołowa Akademia"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
          <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
        </svg>
      </a>
    </div>
    <a href="#kontakt" class="btn btn-lime nav-panel-cta">Zapisz się</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: max(16px, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: max(16px, env(safe-area-inset-left))
                    max(16px, env(safe-area-inset-right));
  }
  .nav-pill {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 12px 10px 18px;
    background: rgba(245, 244, 238, 0.85);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
  }
  .nav-logo { display: flex; align-items: center; min-height: 44px; }
  .nav-logo-img {
    height: 52px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    margin-inline-start: auto;
    font-weight: 600;
  }
  /* Sam napis ma 26px wysokości. min-height podnosi pole kliknięcia do 44px
     bez zmiany wyglądu — pigułka i tak jest wyższa, więc nic się nie rozjeżdża.
     Odstęp 32px gwarantuje, że pola sąsiadów się nie nakładają. */
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav-links a:hover { color: var(--muted); }
  .nav-cta { padding: 10px 24px; }

  /* --- Hamburger --- */
  .nav-burger {
    display: none;               /* na desktopie niepotrzebny */
    position: relative;
    width: 44px; height: 44px;   /* pełne pole dotyku */
    margin-inline-start: auto;
    border: none;
    background: transparent;
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--duration-quick) var(--ease-smooth-out),
                transform var(--duration-quick) var(--ease-smooth-out);
  }
  .nav-burger:active { transform: scale(var(--scale-large)); }
  .nav-burger:hover { background: rgba(0, 0, 0, .05); }

  /* Icon swap: skala bliżej UI chrome (nie .25 = zoom), blur-small. */
  .nav-burger-ic {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity var(--duration-fast) var(--ease-in-out),
                scale var(--duration-fast) var(--ease-in-out),
                filter var(--duration-fast) var(--ease-in-out);
  }
  .nav-burger-ic--zamknij { opacity: 0; scale: .85; filter: blur(var(--blur-small)); }
  .nav[data-open='true'] .nav-burger-ic--menu { opacity: 0; scale: .85; filter: blur(var(--blur-small)); }
  .nav[data-open='true'] .nav-burger-ic--zamknij { opacity: 1; scale: 1; filter: blur(0); }

  /* --- Panel mobilny --- */
  .nav-panel {
    display: none;
    max-width: 800px;
    margin: 10px auto 0;
    padding: 12px;
    background: rgba(245, 244, 238, 0.95);
    backdrop-filter: blur(10px);
    /* promień koncentryczny: 16 (link) + 12 (padding) = 28 */
    border-radius: 28px;
    box-shadow: var(--shadow);
    /* visibility w przejściu, żeby zamknięty panel nie łapał tabulatora */
    visibility: hidden;
    opacity: 0;
    translate: 0 calc(-1 * var(--distance-base));
    transition: opacity var(--duration-quick) var(--ease-smooth-out),
                translate var(--duration-quick) var(--ease-smooth-out),
                visibility 0s linear var(--duration-quick);
  }
  .nav[data-open='true'] .nav-panel {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition: opacity var(--duration-fast) var(--ease-smooth-out),
                translate var(--duration-fast) var(--ease-smooth-out),
                visibility 0s;
  }
  .nav-panel a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 16px;
    border-radius: 16px;
    font-weight: 700;
    transition: background-color var(--duration-quick) var(--ease-smooth-out);
  }
  .nav-panel a:hover { background: rgba(0, 0, 0, .05); }
  .nav-panel-social {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 16px 4px;
  }
  .nav-social-link {
    position: relative;
    width: 24px !important;
    height: 24px !important;
    min-height: 24px !important;
    padding: 0 !important;
    display: grid !important;
    place-items: center;
    color: var(--lime-dark);
    border-radius: 0 !important;
    background: transparent !important;
  }
  .nav-social-link::after {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .nav-social-link svg { display: block; width: 24px; height: 24px; }
  .nav-panel-cta { justify-content: center; margin-top: 24px; }
  .nav-panel-cta:hover { background: var(--lime-dark); }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-ic, .nav-panel { transition-duration: .01ms; }
  }

  /* Na telefonie: CTA tylko w hamburgerze — w pigułce logo + burger */
  @media (max-width: 720px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .nav-burger { display: block; }
    .nav-panel { display: flex; flex-direction: column; }
    .nav-pill {
      gap: 12px;
      padding: 10px 10px 10px 16px;
    }
  }
</style>

<script>
  const nav = document.querySelector('.nav') as HTMLElement;
  const burger = document.getElementById('nav-burger');
  const panel = document.getElementById('nav-panel');
  const waskiEkran = window.matchMedia('(max-width: 720px)');

  const otwarty = () => nav.dataset.open === 'true';

  const ustaw = (open: boolean) => {
    nav.dataset.open = String(open);
    burger?.setAttribute('aria-expanded', String(open));
    // blokada scrolla jak w modalach — inaczej tło przewija się pod panelem
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) (window as any).lenis?.stop();
    else (window as any).lenis?.start();
  };

  burger?.addEventListener('click', () => ustaw(!otwarty()));

  // klik w link zamyka menu, żeby po skoku do sekcji nie zasłaniało treści
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => ustaw(false))
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && otwarty()) {
      ustaw(false);
      burger?.focus();   // fokus wraca na przycisk, nie ucieka na początek strony
    }
  });

  // klik poza nawigacją zamyka
  document.addEventListener('click', (e) => {
    if (otwarty() && !nav.contains(e.target as Node)) ustaw(false);
  });

  // po powiększeniu okna panel znika — bez tego zostałby otwarty
  // razem z zablokowanym scrollem
  waskiEkran.addEventListener('change', (e) => {
    if (!e.matches && otwarty()) ustaw(false);
  });
</script>
