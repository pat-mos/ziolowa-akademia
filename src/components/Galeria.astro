---
import { Image } from 'astro:assets';
import g1 from '../assets/img/galeria-1.jpeg';
import g2 from '../assets/img/galeria-2.jpeg';
import g3 from '../assets/img/galeria-3.jpeg';
import g4 from '../assets/img/galeria-4.jpeg';

const zdjecia = [
  {
    src: g1,
    alt: 'Dziewczynki na kocach na łące lepią z gliny podczas warsztatów plenerowych',
  },
  {
    src: g2,
    alt: 'Stół warsztatowy z paprociami, gliną i przepisem na łąkowy napar',
  },
  {
    src: g3,
    alt: 'Kompozycja z suszonych ziół i kwiatów na drewnianej deseczce',
  },
  {
    src: g4,
    alt: 'Dzieci pokazują karty z zebranymi liśćmi i roślinami z łąki',
  },
];
// Powielamy listę, aby pas przewijał się w nieskończoność bez przerwy.
const petla = [...zdjecia, ...zdjecia];
---
<section class="section galeria falbanka-gora falbanka-dol">
  <div class="container">
    <span class="eyebrow">Nasze zajęcia</span>
    <h2 class="section-title">Chwile uchwycone podczas warsztatów</h2>
  </div>

  <div class="marquee" data-galeria tabindex="0" role="region" aria-label="Galeria zdjęć z warsztatów — przeciągnij, aby przewinąć">
    <div class="track">
      {petla.map((item, i) => (
        <Image
          src={item.src}
          alt={i < zdjecia.length ? item.alt : ''}
          widths={[400, 800]}
          sizes="(max-width: 720px) 72vw, 400px"
          draggable="false"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    margin-top: 40px;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .track {
    display: flex;
    gap: 20px;
    width: max-content;
    padding-inline: 24px;
  }
  .track img {
    width: 400px;
    height: 400px;
    object-fit: cover;
    border-radius: var(--radius);
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    flex-shrink: 0;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .track img {
      width: min(280px, 72vw);
      height: min(280px, 72vw);
    }
    .track { gap: 16px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-galeria]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = false;

    const half = () => root.scrollWidth / 2;

    const loopScroll = () => {
      const h = half();
      if (h <= 0) return;
      if (root.scrollLeft >= h) root.scrollLeft -= h;
      else if (root.scrollLeft < 0) root.scrollLeft += h;
    };

    root.addEventListener('pointerdown', (e) => {
      // Dotyk: natywny scroll; mysz/pióro: drag
      if (e.pointerType === 'touch') return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startScroll = root.scrollLeft;
      root.classList.add('is-dragging');
      root.setPointerCapture(e.pointerId);
    });

    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      root.scrollLeft = startScroll - dx;
      loopScroll();
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-dragging');
    };
    root.addEventListener('pointerup', endDrag);
    root.addEventListener('pointercancel', endDrag);
    root.addEventListener('lostpointercapture', endDrag);

    // Po drag nie otwieraj obrazka / nie zaznaczaj
    root.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    });

    root.addEventListener('scroll', () => loopScroll(), { passive: true });

    if (!reduce) {
      let last = performance.now();
      const speed = 0.035; // px / ms ≈ CSS 48s na pełną pętlę przy typowej szerokości
      const tick = (now: number) => {
        const dt = now - last;
        last = now;
        if (!dragging && !root.matches(':hover') && document.visibilityState === 'visible') {
          root.scrollLeft += dt * speed;
          loopScroll();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
