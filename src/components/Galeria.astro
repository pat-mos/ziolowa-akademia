---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/galeria-*.jpeg',
  { eager: true },
);

const altByIndex: Record<number, string> = {
  1: 'Dziewczynki na kocach na łące lepią z gliny podczas warsztatów plenerowych',
  2: 'Stół warsztatowy z paprociami, gliną i przepisem na łąkowy napar',
  3: 'Kompozycja z suszonych ziół i kwiatów na drewnianej deseczce',
  4: 'Dzieci pokazują karty z zebranymi liśćmi i roślinami z łąki',
};

const zdjecia = Object.entries(modules)
  .map(([path, mod]) => {
    const n = Number(path.match(/galeria-(\d+)\.jpeg$/)?.[1] ?? 0);
    return {
      n,
      src: mod.default,
      alt: altByIndex[n] ?? 'Zdjęcie z warsztatów Ziołowej Akademii',
    };
  })
  .sort((a, b) => a.n - b.n);

// Powielamy listę, aby pas przewijał się w nieskończoność bez przerwy.
const petla = [...zdjecia, ...zdjecia];
---
<section class="section galeria falbanka-gora falbanka-dol">
  <div class="container">
    <span class="eyebrow">Nasze zajęcia</span>
    <h2 class="section-title">Chwile uchwycone podczas warsztatów</h2>
  </div>

  <div class="marquee" data-galeria tabindex="0" role="region" aria-label="Galeria zdjęć z warsztatów — przeciągnij, aby przewinąć">
    <div class="track">
      {petla.map((item, i) => (
        <Image
          src={item.src}
          alt={i < zdjecia.length ? item.alt : ''}
          widths={[400, 800]}
          sizes="(max-width: 720px) 72vw, 400px"
          draggable="false"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    margin-top: 40px;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .track {
    display: flex;
    gap: 20px;
    width: max-content;
    padding-inline: 24px;
  }
  .track img {
    width: 400px;
    height: 400px;
    object-fit: cover;
    border-radius: var(--radius);
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    flex-shrink: 0;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .track img {
      width: min(280px, 72vw);
      height: min(280px, 72vw);
    }
    .track { gap: 16px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-galeria]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Pause-on-hover tylko dla myszy — na mobile :hover „przykleja się”
    // po tapnięciu i zabijało auto-scroll.
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let dragging = false;
    let touchPaused = false;
    let touchResumeTimer: number | null = null;
    let startX = 0;
    let startScroll = 0;
    let moved = false;

    const half = () => root.scrollWidth / 2;

    const loopScroll = () => {
      const h = half();
      if (h <= 0) return;
      if (root.scrollLeft >= h) root.scrollLeft -= h;
      else if (root.scrollLeft < 0) root.scrollLeft += h;
    };

    root.addEventListener('pointerdown', (e) => {
      // Dotyk: natywny scroll; mysz/pióro: drag
      if (e.pointerType === 'touch') return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startScroll = root.scrollLeft;
      root.classList.add('is-dragging');
      root.setPointerCapture(e.pointerId);
    });

    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      root.scrollLeft = startScroll - dx;
      loopScroll();
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-dragging');
    };
    root.addEventListener('pointerup', endDrag);
    root.addEventListener('pointercancel', endDrag);
    root.addEventListener('lostpointercapture', endDrag);

    // Podczas przeciągania palcem pauza auto-scrollu; po chwili wznawia.
    root.addEventListener('touchstart', () => {
      touchPaused = true;
      if (touchResumeTimer !== null) window.clearTimeout(touchResumeTimer);
    }, { passive: true });
    root.addEventListener('touchend', () => {
      if (touchResumeTimer !== null) window.clearTimeout(touchResumeTimer);
      touchResumeTimer = window.setTimeout(() => { touchPaused = false; }, 1800);
    }, { passive: true });
    root.addEventListener('touchcancel', () => {
      if (touchResumeTimer !== null) window.clearTimeout(touchResumeTimer);
      touchResumeTimer = window.setTimeout(() => { touchPaused = false; }, 1800);
    }, { passive: true });

    // Po drag nie otwieraj obrazka / nie zaznaczaj
    root.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    });

    root.addEventListener('scroll', () => loopScroll(), { passive: true });

    if (!reduce) {
      let last = performance.now();
      const speed = 0.035; // px / ms ≈ CSS 48s na pełną pętlę przy typowej szerokości
      const tick = (now: number) => {
        const dt = now - last;
        last = now;
        const hoverPause = finePointer.matches && root.matches(':hover');
        if (
          !dragging &&
          !touchPaused &&
          !hoverPause &&
          document.visibilityState === 'visible'
        ) {
          root.scrollLeft += dt * speed;
          loopScroll();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
