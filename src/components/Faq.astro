---
const pytania = [
  {
    q: 'Czy dojeżdżacie do klienta?',
    a: 'Tak. Wszystkie warsztaty realizujemy z dojazdem do klienta. Standardowo prowadzimy zajęcia na terenie województwa śląskiego, jednak w przypadku większych grup lub rezerwacji kilku bloków warsztatowych dojeżdżamy również do innych regionów Polski.',
  },
  {
    q: 'Czy materiały są wliczone w cenę warsztatów?',
    a: 'Tak. Cena warsztatów obejmuje wszystkie niezbędne materiały, surowce i narzędzia potrzebne do przeprowadzenia zajęć. Nie pobieramy żadnych dodatkowych opłat za wyposażenie.',
  },
  {
    q: 'Czy uczestnicy muszą przynieść własne materiały lub narzędzia?',
    a: 'Nie. Zapewniamy komplet materiałów oraz wszystkie potrzebne akcesoria. Uczestnicy mogą skupić się wyłącznie na dobrej zabawie i tworzeniu własnych prac.',
  },
  {
    q: 'Co się dzieje z warsztatami w przypadku złej pogody?',
    a: 'Jeżeli warunki pogodowe uniemożliwiają realizację zajęć w terenie, warsztaty przenosimy do sali udostępnionej przez placówkę lub – po wcześniejszym uzgodnieniu – przekładamy je na inny dogodny termin.',
  },
  {
    q: 'Jak można zarezerwować termin warsztatów?',
    a: 'Rezerwacji można dokonać telefonicznie lub mailowo. Chętnie pomożemy dobrać odpowiedni termin, temat warsztatów oraz ofertę dopasowaną do wieku uczestników i liczebności grupy.',
  },
  {
    q: 'Czy wystawiacie faktury dla szkół, przedszkoli i firm?',
    a: 'Tak. Wystawiamy faktury dla szkół, przedszkoli, firm, instytucji oraz innych podmiotów. Rozliczenie przebiega sprawnie i zgodnie z obowiązującymi przepisami.',
  },
];
---
<section class="section faq">
  <div class="container">
    <div class="faq-head">
      <span class="eyebrow">FAQ</span>
      <h2 class="section-title">Najczęstsze pytania</h2>
      <p>Nie znalazłeś odpowiedzi? Napisz do nas — chętnie pomożemy.</p>
    </div>

    <div class="faq-list">
      {pytania.map((p) => (
        <div class="faq-item">
          <button class="faq-q" type="button" aria-expanded="false">
            <span>{p.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </button>
          <div class="faq-a" hidden>
            <div class="faq-a-inner">
              <p>{p.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Akordeon na wysokości (nie grid 0fr→1fr) — Safari/iOS przy pierwszym
  // tapnięciu zostawiał panel na 0px mimo klasy .open.
  const items = [...document.querySelectorAll<HTMLElement>('.faq-item')];

  const panelOf = (item: HTMLElement) => item.querySelector<HTMLElement>('.faq-a');
  const btnOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('.faq-q');
  const innerOf = (item: HTMLElement) => item.querySelector<HTMLElement>('.faq-a-inner');

  const closeItem = (item: HTMLElement) => {
    const panel = panelOf(item);
    const btn = btnOf(item);
    const inner = innerOf(item);
    if (!panel || !btn || !inner) return;
    if (!item.classList.contains('open')) {
      panel.hidden = true;
      panel.style.height = '';
      return;
    }
    // Z auto → px, potem 0, żeby transition zadziałał.
    panel.style.height = `${inner.scrollHeight}px`;
    panel.getBoundingClientRect(); // reflow
    item.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
    panel.style.height = '0px';
    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== 'height') return;
      panel.removeEventListener('transitionend', onEnd);
      if (!item.classList.contains('open')) {
        panel.hidden = true;
        panel.style.height = '';
      }
    };
    panel.addEventListener('transitionend', onEnd);
  };

  const openItem = (item: HTMLElement) => {
    const panel = panelOf(item);
    const btn = btnOf(item);
    const inner = innerOf(item);
    if (!panel || !btn || !inner) return;
    panel.hidden = false;
    panel.style.height = '0px';
    item.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    // Dwa rAF: pierwszy po usunięciu [hidden], drugi po zmierzeniu treści.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        panel.style.height = `${inner.scrollHeight}px`;
      });
    });
    const finish = () => {
      panel.removeEventListener('transitionend', onEnd);
      if (item.classList.contains('open')) panel.style.height = 'auto';
    };
    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== 'height') return;
      finish();
    };
    panel.addEventListener('transitionend', onEnd);
    window.setTimeout(finish, 320);
  };

  items.forEach((item) => {
    const btn = btnOf(item);
    btn?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((it) => {
        if (it !== item) closeItem(it);
      });
      if (willOpen) openItem(item);
      else closeItem(item);
    });
  });
</script>

<style>
  /* Nagłówek na górze — jeden odstęp do listy (bez podwójnego dołu na p) */
  .faq-head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
  .faq-head p { color: var(--muted); margin: 18px 0 0; }

  /* Lista pytań — pełna szerokość kontenera */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Pytanie = wypełniony, zaokrąglony kafel #f0f5f2 (jak w oryginale) */
  .faq-item {
    background: #f0f5f2;
    border-radius: 32px;
    overflow: hidden;
  }
  .faq-q {
    width: 100%;
    text-align: start;
    background: none;
    border: none;
    padding: 24px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    font-family: var(--font);
    font-weight: var(--weight-ui);
    font-size: 1.2rem;
    line-height: 1.4;
    color: #000;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation; /* bez 300ms delay / double-tap zoom */
  }
  .faq-icon {
    display: grid;
    place-items: center;
    color: var(--ink);
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    transition: transform var(--duration-fast) var(--ease-smooth-out);
  }
  .faq-icon svg { display: block; }
  /* „+" obraca się o 45° → wygląda jak „×" po otwarciu */
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .faq-a {
    height: 0;
    overflow: hidden;
    transition: height var(--duration-fast) var(--ease-smooth-out);
  }
  .faq-a[hidden] {
    display: block; /* height anim; hidden tylko dla a11y/stanu startowego */
    height: 0;
  }
  .faq-a-inner { min-height: 0; }
  .faq-a p { color: var(--muted); padding: 0 30px 28px; line-height: var(--lh-body); }

  @media (max-width: 520px) {
    .faq-q { padding: 20px 24px; font-size: 1.05rem; }
    .faq-a p { padding: 0 24px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-a { transition: none; }
    .faq-icon { transition: none; }
  }
</style>
