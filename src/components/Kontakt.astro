---
import { Image } from 'astro:assets';
import plakat from '../assets/img/oferta-2.jpeg';

// UWAGA: uzupełnij prawdziwe dane kontaktowe poniżej.
const email = 'monikawierus@wp.pl';

// FILM — jak wrzucić własne wideo:
// 1. skopiuj plik .mp4 do folderu `public/video/` (np. public/video/kontakt.mp4)
// 2. wpisz tu ścieżkę: const film = '/video/kontakt.mp4';
// Puste = pokazuje zdjęcie zamiast wideo.
const film = '';
---
<section class="section kontakt" id="kontakt">
  <div class="container">

    <div class="k-card">
      {/* --- LEWY: tekst + krótki formularz --- */}
      <div class="k-info">
        <h2 class="section-title">Natura to najlepsza sala lekcyjna</h2>
        <p class="k-lead">
          Napisz kilka słów o grupie — dobierzemy warsztat i zaproponujemy termin.
        </p>

        <form class="k-form" data-email={email}>
          <div class="k-row">
            <label class="field">
              <span class="field-label">Imię</span>
              <input type="text" name="imie" autocomplete="given-name" placeholder="np. Anna" required />
            </label>
            <label class="field">
              <span class="field-label">Telefon <span class="field-opc">(opcjonalnie)</span></span>
              <input type="tel" name="telefon" autocomplete="tel" inputmode="tel" placeholder="np. 500 000 000" />
            </label>
          </div>
          <label class="field">
            <span class="field-label">E-mail</span>
            <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="np. anna@szkola.pl" required />
          </label>
          <label class="field">
            <span class="field-label">Wiadomość</span>
            <textarea name="wiadomosc" rows="3" placeholder="Wiek grupy, liczba osób, temat…" required></textarea>
          </label>
          <button type="submit" class="btn btn-lime">Wyślij wiadomość</button>
          {/* komunikat po wysłaniu — pusty do czasu kliknięcia */}
          <p class="k-note" role="status" aria-live="polite"></p>
        </form>


      </div>

      {/* --- PRAWY: zdjęcie / film --- */}
      <div class="k-film">
        {film ? (
          <video class="k-video" src={film} controls preload="none" poster={plakat.src}></video>
        ) : (
          <Image src={plakat} alt="Kadr z warsztatów Ziołowej Akademii" widths={[600, 1000]} sizes="(max-width: 900px) 90vw, 620px" />
        )}
      </div>
    </div>
  </div>
</section>

<script>
  // Formularz buduje wiadomość i otwiera klienta poczty (mailto) —
  // działa na dowolnym hostingu statycznym, bez serwera.
  const form = document.querySelector('.k-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.dataset.email || '';
    const d = new FormData(form);
    const subject = encodeURIComponent('Zapytanie o warsztaty — Ziołowa Akademia');
    const body = encodeURIComponent(
      `Imię: ${d.get('imie')}\n` +
      `Telefon: ${d.get('telefon') || '—'}\n` +
      `E-mail: ${d.get('email')}\n\n` +
      `${d.get('wiadomosc')}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

    const note = form.querySelector('.k-note');
    if (note) {
      note.textContent = '✓ Otwieramy Twój program pocztowy z gotową wiadomością…';
      note.classList.add('k-note--ok');
    }
  });
</script>

<style>
  /* Dwa bloki obok siebie. Wysokość rzędu = treść formularza;
     film dogania przez min-height:100% + height:0 (bez pustki pod CTA). */
  .k-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  /* Lewa karta: mech / szałwia — spokojniej niż glina, bliżej FAQ */
  .k-info {
    background: var(--pastel-szczaw);
    color: var(--ink);
    border-radius: 32px;
    padding: 36px 36px 32px;
    display: flex;
    flex-direction: column;
  }
  .k-info .section-title {
    text-align: start;
    margin-inline: 0;
    color: var(--ink);
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
  }
  .k-lead { color: var(--muted); margin: 12px 0 20px; max-width: 34ch; }

  /* --- Formularz --- */
  .k-form { display: flex; flex-direction: column; gap: 12px; }
  .k-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .field-label {
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    color: var(--ink);
    padding-inline-start: 4px;
  }
  .field-opc {
    font-weight: var(--weight-body);
    color: var(--muted);
  }
  .k-form input,
  .k-form textarea {
    width: 100%;
    font-family: var(--font);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--ink);
    background: var(--white);
    border: 1.5px solid transparent;
    border-radius: 16px;
    padding: 12px 16px;
    min-height: 44px;
    box-shadow: 0 1px 2px oklch(0.255 0.040 152 / 0.06),
                0 0 0 1px oklch(0.255 0.040 152 / 0.04);
    transition: border-color var(--duration-quick) var(--ease-smooth-out),
                box-shadow var(--duration-quick) var(--ease-smooth-out);
  }
  .k-form textarea { resize: vertical; min-height: 88px; }
  .k-form input::placeholder,
  .k-form textarea::placeholder { color: var(--muted); }
  .k-form input:hover,
  .k-form textarea:hover {
    box-shadow: 0 1px 3px oklch(0.255 0.040 152 / 0.08),
                0 0 0 1px oklch(0.55 0.06 155 / 0.35);
  }
  .k-form input:focus-visible,
  .k-form textarea:focus-visible {
    outline: none;
    border-color: oklch(0.55 0.09 155);
    box-shadow: 0 0 0 4px oklch(0.82 0.05 155 / 0.45);
  }
  .k-form .btn {
    /* gap 12 + 20 = 32px od pola wyżej */
    margin-top: 20px;
    width: 100%;
  }
  .k-note {
    font-size: .85rem;
    color: var(--muted);
    margin: 0;
  }
  .k-note:empty { display: none; }
  .k-note--ok { color: var(--herb); font-weight: 700; }

  /* --- Film: bez paddingu/ramki, ten sam rozmiar i radius co formularz --- */
  .k-film {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
    background: var(--cream);
    height: 0;
    min-height: 100%;
  }
  .k-film img,
  .k-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 32px;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  .k-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 72px; height: 72px;
    border: none;
    border-radius: 50%;
    background: var(--white);
    color: var(--herb);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 30px rgba(31, 42, 28, .25);
    transition: transform var(--duration-quick) var(--ease-smooth-out),
                background-color var(--duration-quick) var(--ease-smooth-out);
  }
  .k-play svg { width: 28px; height: 28px; margin-inline-start: 3px; }
  .k-play:hover { transform: scale(1.04); }
  .k-play:active { transform: scale(var(--scale-large)); }

  @media (max-width: 900px) {
    .k-card { grid-template-columns: 1fr; }
    .k-info,
    .k-film { border-radius: 26px; }
    .k-info { padding: 28px 24px 24px; }
    .k-row { grid-template-columns: 1fr; }
    /* Pod formularzem: stały ratio + absolute cover — bez rozciągania img */
    .k-film {
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .k-film img,
    .k-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      border-radius: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-play { transition: none; }
  }
</style>
