---
// Strona główna — składamy sekcje w kolejności jak na oryginale.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Wartosci from '../components/Wartosci.astro';
import Oferta from '../components/Oferta.astro';
import Opinie from '../components/Opinie.astro';
import Galeria from '../components/Galeria.astro';
import Faq from '../components/Faq.astro';
import Kontakt from '../components/Kontakt.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <main id="main">
    <Hero />
    {/* Treść przewija się NAD przyklejonym w tle hero */}
    <div class="page-content falbanka-gora">
      <Wartosci />
      <Oferta />
      <Opinie />
      <Galeria />
      <Faq />
      <Kontakt />
      <Footer />
    </div>
  </main>
</Layout>
