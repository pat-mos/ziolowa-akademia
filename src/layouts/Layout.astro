---
// Layout = wspólny szkielet HTML dla każdej strony.
// Właściwa treść trafia w miejsce <slot />.
import '../styles/global.css';

const {
  title = 'Ziołowa Akademia — warsztaty i spacery botaniczne',
  description = 'Warsztaty ziołowe, spacery botaniczne i kąpiele leśne dla przedszkoli, szkół oraz dorosłych. Edukacja przez kontakt z naturą.',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f2a1c" />
    <script is:inline>
      // Zapala stany startowe wjazdu sekcji JESZCZE przed pierwszym malowaniem.
      // Gdyby ta klasa szła z modułu na końcu <body>, treść mignęłaby w pełnym
      // kryciu i dopiero potem zgasła.
      (function () {
        var html = document.documentElement;
        // Bez IntersectionObservera nie ma czym odsłonić — nie chowamy nic.
        if (!('IntersectionObserver' in window)) return;
        html.classList.add('js-anim');
        // BEZPIECZNIK. Treść czeka tu na JavaScript, więc awaria modułu
        // (np. błąd importu Lenisa) zostawiłaby PUSTĄ stronę. Jeśli obserwator
        // nie zdąży się zgłosić, odsłaniamy wszystko bez animacji.
        // W karcie w tle moduł i tak wystartuje i ustawi tę flagę, więc
        // bezpiecznik nie odbierze animacji komuś, kto otworzył link w tle.
        setTimeout(function () {
          if (!window.__wjazdGotowy) html.classList.remove('js-anim');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <slot />

    <!-- Pasek z blurem u dołu ekranu — maskuje nadchodzącą sekcję -->
    <div class="page-bottom-blur" aria-hidden="true"></div>

    <script>
      // Smooth scroll (Lenis) — tylko desktop / fine pointer.
      // Na telefonie natywny momentum scroll jest lepszy i nie gryzie się z fixed hero.
      import Lenis from 'lenis';

      const prefersCoarse = window.matchMedia('(pointer: coarse)').matches;
      const isNarrow = window.matchMedia('(max-width: 900px)').matches;
      const useLenis = !prefersCoarse && !isNarrow;

      let lenis: InstanceType<typeof Lenis> | null = null;
      if (useLenis) {
        lenis = new Lenis({ duration: 1.1 });
        function raf(time: number) {
          lenis!.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }
      (window as any).lenis = lenis;

      // --- Wjazd sekcji ---
      const doWjazdu = document.querySelectorAll('.page-content .section > .container');
      const obserwator = new IntersectionObserver(
        (wpisy) => {
          wpisy.forEach((w) => {
            if (!w.isIntersecting) return;
            w.target.classList.add('widoczny');
            obserwator.unobserve(w.target);
          });
        },
        // Dodatni dolny rootMargin: sekcja dostaje .widoczny zanim użytkownik
        // zdąży w nią kliknąć (wcześniej -8% + opacity:0 = „martwy” pierwszy tap).
        { threshold: 0.08, rootMargin: '0px 0px 12% 0px' }
      );
      doWjazdu.forEach((el) => obserwator.observe(el));
      (window as any).__wjazdGotowy = true;

      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href') || '';
          if (href.length <= 1) return;
          e.preventDefault();
          if (lenis) lenis.scrollTo(href);
          else document.querySelector(href)?.scrollIntoView({ behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>
